# ── Python / virtualenvs ──────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.env

# ── Build artefacts ───────────────────────────────────────────────────────
dist/
build/
release/
*.egg-info/

# ── Tooling caches ────────────────────────────────────────────────────────
.pytest_cache/
tests/.pytest_cache/
.ruff_cache/
.mypy_cache/
# CodeGraph local index (per-repo, never committed)
.codegraph/
.vscode/

# NOTE: uv.lock is deliberately NOT ignored -- it is the committed lockfile
# that makes `uv sync` reproducible in CI and on a fresh clone.

# ── Runtime state (written by the app, never source of truth) ─────────────
# App config: personal machine paths + avatar blob. Shipped as
# config.example.json; the app recreates config.json on first save and
# tolerates its absence (_resolve_profile_dir guards on .exists()).
config.json
profiles/last_profile.txt
# Runtime-generated mirror of the bundled Default profiles (User-Wunsch,
# 2026-09-10), regenerated on every app launch -- never the source of truth,
# so committing it would just be a stale duplicate of Default*.json.
profiles/Backup/
app.log
*.db
*.sqlite
*.sqlite3

# ── ItemDatabase — cached API data/icons, not source ──────────────────────
ItemDatabase/data/

# ── Discord announcement draft — internal, not part of the repo ───────────
DISCORD.md

# ── Ad-hoc dev scratch scripts dropped in the repo root ───────────────────
# Root-anchored on purpose: the old unanchored `test_*.py` pattern also
# swallowed the real suite under tests/, so pytest files were invisible to
# git and could never be committed.
/test_*.py
!tests/
