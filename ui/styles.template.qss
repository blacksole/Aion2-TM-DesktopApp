/* ---------------------------------------------------------------------
   14. Migrated inline styles  (wave 2026-09-18)

   Every rule below replaces a `setStyleSheet(...)` call that used to live
   in a widget (MASTER §4-4).  Grouped here, with the call site named, so
   the next person can see at a glance what the widgets stopped doing for
   themselves.
   ------------------------------------------------------------------ */

/* QAbstractScrollArea paints its viewport from QPalette::Base, which the
   outer widget's own rule never reaches -- it showed as a light grey box
   under a dark theme (User-reported, 2026-08-29).  Nine call sites used to
   push `background: transparent` onto the viewport directly; they now name
   it instead. */
QWidget[aion2="true"] #transparentViewport {
    background: transparent;
}

/* HeaderWidget._apply_avatar_pixmap: a real (already circle-clipped)
   picture must not sit on the accent disc the initials state uses. */
QWidget[aion2="true"] #profileAvatar[hasAvatar="true"] {
    background: transparent;
}

/* Big numbers — MASTER §3 ("gros chiffres" in font.display/mono): the
   Timers page cards and the custom-timer dialog's preview.  The COLOUR is
   still set per widget, because it is the timer's own data colour
   (MASTER §4-4). */
QWidget[aion2="true"] #bigValue {
    font-family: {{font_mono}};
    font-size: {{text_2xl}}px;
    font-weight: {{font_weight_bold}};
    background: transparent;
}

/* settings_page._LogViewerDialog: app.log is column-aligned output. */
QWidget[aion2="true"] #logViewerText {
    font-family: {{font_mono}};
    font-size: {{text_xs}}px;
}

/* custom_timer_dialog: the 8 colour swatches.  Fill = the swatch's own
   colour (data); the ring is the theme's (it was a hardcoded white). */
QWidget[aion2="true"] #ctColorSwatch {
    border: {{focus_ring_width}}px solid transparent;
    border-radius: {{radius_md}}px;
}

QWidget[aion2="true"] #ctColorSwatch:hover {
    border-color: {{fg_muted}};
}

QWidget[aion2="true"] #ctColorSwatch:checked {
    border-color: {{fg}};
}

/* custom_timer_manager_dialog: a category marker (theme) and a timer's own
   colour dot (data -- colour set in code, size here). */
QWidget[aion2="true"] #ctCategoryDot {
    color: {{accent}};
    font-size: {{text_md}}px;
    background: transparent;
}

QWidget[aion2="true"] #ctTimerColorDot {
    font-size: {{text_lg}}px;
    background: transparent;
}

/* template_dialog._h_separator */
QWidget[aion2="true"] #dialogSeparator {
    color: {{border}};
    background: {{border}};
    max-height: {{border_width}}px;
    border: none;
}

/* tasks_page._show_char_filter_popover: a rounded popup, matching the
   overlay's own filter menu (User-Wunsch, 2026-09-16).  Was an inline
   sheet because a QMenu did not inherit MainWindow's stylesheet; it
   inherits the QApplication's. */
QWidget[aion2="true"] #charFilterMenu {
    background-color: {{bg_overlay}};
    color: {{fg}};
    border: {{border_width}}px solid {{border_strong}};
    border-radius: {{radius_md}}px;
    padding: {{space_1}}px;
}

QWidget[aion2="true"] #charFilterMenu::item {
    padding: {{space_2}}px {{space_6}}px;
    border-radius: {{radius_sm}}px;
}

QWidget[aion2="true"] #charFilterMenu::item:selected {
    background-color: {{accent_soft}};
    color: {{fg}};
}

QWidget[aion2="true"] #charFilterMenu::separator {
    height: {{border_width}}px;
    background: {{border}};
    margin: {{space_1}}px {{space_2}}px;
}

/* flow_node_card: three discrete zoom steps, previously three inline
   font-size literals (18/16/15 and 13/12/1 px, none of them on MASTER
   §1's scale). */
QWidget[aion2="true"] #FlowNodeTitle[zoomStep="full"] {
    font-size: {{text_lg}}px;
}

QWidget[aion2="true"] #FlowNodeTitle[zoomStep="mid"] {
    font-size: {{text_md}}px;
}

QWidget[aion2="true"] #FlowNodeTitle[zoomStep="small"] {
    font-size: {{text_sm}}px;
}

QWidget[aion2="true"] #FlowNodeDescription[zoomStep="full"] {
    font-size: {{text_base}}px;
}

QWidget[aion2="true"] #FlowNodeDescription[zoomStep="mid"] {
    font-size: {{text_sm}}px;
}

QWidget[aion2="true"] #FlowNodeDescription[zoomStep="small"] {
    font-size: {{text_xs}}px;
}

/* flow_guide_view.show_node_info: the info dot IS the node's status. */
QWidget[aion2="true"] #FlowInfoIcon[status="completed"] {
    color: {{ok}};
    border-color: {{ok}};
}

QWidget[aion2="true"] #FlowInfoIcon[status="active"] {
    color: {{accent}};
    border-color: {{accent}};
}

QWidget[aion2="true"] #FlowInfoIcon[status="optional"] {
    color: {{warn}};
    border-color: {{warn}};
}

QWidget[aion2="true"] #FlowInfoIcon[status="locked"],
QWidget[aion2="true"] #FlowInfoIcon[status="none"] {
    color: {{fg_muted}};
    border-color: {{border}};
}

/* Overlay -------------------------------------------------------------- */

/* The tab / schedule letter on a HUD row (MASTER §3 badge: full-colour
   text on its own soft fill).  Was an inline rgba() built from a per-tab
   QColor literal, with near-white text on a saturated fill. */
QWidget[aion2="true"] #OverlayBadge {
    color: {{secondary}};
    background-color: {{secondary_soft}};
    border-radius: {{radius_sm}}px;
    padding: 0px {{space_1}}px;
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_bold}};
}

/* OverlayGuideRow's ACTV / LOCK / DONE / OPT label. */
QWidget[aion2="true"] #OverlayStatusLabel {
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_bold}};
    background: transparent;
}

QWidget[aion2="true"] #OverlayStatusLabel[status="completed"] {
    color: {{ok}};
}

QWidget[aion2="true"] #OverlayStatusLabel[status="active"] {
    color: {{accent}};
}

QWidget[aion2="true"] #OverlayStatusLabel[status="optional"] {
    color: {{warn}};
}

QWidget[aion2="true"] #OverlayStatusLabel[status="locked"] {
    color: {{fg_muted}};
}

/* The "this profile is live" dot in the HUD's title bar. */
QWidget[aion2="true"] #OverlayLiveDot {
    color: {{accent}};
    font-size: {{text_xs}}px;
    background: transparent;
}

/* The Countdown Timer's Start/Stop button carries a per-timer DATA fill
   (set in code), so it needs on-accent text and no border -- unlike the
   plain #OverlayCountdownToggleBtn rule above, which assumes a
   transparent background. */
QWidget[aion2="true"] #OverlayCountdownToggleBtn[running="true"],
QWidget[aion2="true"] #OverlayCountdownToggleBtn[running="false"] {
    color: {{fg_on_accent}};
    border: none;
    border-radius: {{radius_md}}px;
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_bold}};
}

/* MASTER §3 "État vide" — one place the hint colour is defined, reachable
   by widgets that already own their objectName (the overlay's empty row
   carries this as a `class` property). */
QWidget[aion2="true"] QLabel[class="emptyStateHint"] {
    color: {{fg_muted}};
}

/* ---------------------------------------------------------------------
   15. Armory dashboard  (MASTER §3 "Carte" + "Champ"/badge type scale —
   audit §3 Phase 4c: the Armory landing page is a summary of the
   persisted Build Planner state, so its cards need the card surface, the
   caps title, the display-face figure and the muted hint line.

   Appended as one block on purpose (the section numbering above is the
   file's own history, not a sort key): every rule here is new, none of
   the rules above is touched.  `#armoryCardRow` in §0b/§4 is the old
   launcher row this page no longer builds — left in place because those
   are shared selector lists.
   ------------------------------------------------------------------ */

QWidget[aion2="true"] #armoryCard {
    background-color: {{bg_elevated}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_md}}px;
    min-height: 84px;
}

QWidget[aion2="true"] #armoryCard:hover {
    background-color: {{bg_overlay}};
    border-color: {{accent}};
}

/* Same shape as every other card's focus rule (§0b): the card carries a
   1 px resting border and no QSS padding of its own, so the ring IS the
   edge colour and nothing moves when focus lands. */
QWidget[aion2="true"] #armoryCard:focus {
    border-color: {{accent}};
}

/* MASTER §3 card title: caps, muted, semibold — the label of the figure
   below it, never competing with it. */
QWidget[aion2="true"] #armoryCardTitle {
    color: {{fg_muted}};
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_semibold}};
    letter-spacing: {{letter_spacing_caps}};
}

/* The one big figure per card, in the display face (MASTER §1). */
QWidget[aion2="true"] #armoryCardValue {
    color: {{fg}};
    font-family: {{font_display}};
    font-size: {{text_xl}}px;
    font-weight: {{font_weight_bold}};
}

QWidget[aion2="true"] #armoryCardHint {
    color: {{fg_secondary}};
    font-size: {{text_sm}}px;
}

/* The CTA is a link-weight action inside a card that is itself clickable,
   so it reads as accent text, not as a second primary button fighting the
   card for the eye (MASTER §3: one primary per surface). */
QWidget[aion2="true"] #armoryCardCta {
    background: transparent;
    color: {{accent}};
    border: {{border_width}}px solid transparent;
    border-radius: {{radius_sm}}px;
    padding: {{space_1}}px {{space_2}}px;
    font-size: {{text_base}}px;
    font-weight: {{font_weight_semibold}};
}

QWidget[aion2="true"] #armoryCardCta:hover {
    background-color: {{accent_soft}};
    border-color: {{accent}};
    color: {{accent}};
}

QWidget[aion2="true"] #armoryCardCta:pressed {
    background-color: {{accent_soft}};
    border-color: {{accent}};
}

QWidget[aion2="true"] #armoryCardCta:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    border-radius: {{radius_sm}}px;
    padding: {{space_1_inset}}px {{space_2_inset}}px;
}

/* Stage 2 (2026-09-19): the Recommendations card.  Audit
   docs/audit-2026-09-18/B-armory.md §3.4 features #1/#2 — the Armory
   engine's first two solvers, rendered on the landing page.

   Appended inside §15 rather than opening a §16: it is the same page, the
   same surface and the same type scale as the cards above, and the only
   reason it needs rules of its own is that its content is a LIST (rows,
   each with a disclosure) instead of one figure.  Nothing above is
   touched. */

/* Same ground, border and radius as `#armoryCard` — the page must read as
   one set of cards — but no `:hover`/`:focus` accent: this card is not a
   button.  Its rows are individually interactive, so a card-wide hover
   would promise a click the frame does not handle. */
QWidget[aion2="true"] #armoryRecoCard {
    background-color: {{bg_elevated}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_md}}px;
}

/* The row is a plain container: it carries the separation between
   recommendations (its layout spacing) and no surface of its own, so a
   rendered card shows a list, not a stack of nested boxes. */
QWidget[aion2="true"] #armoryRecoItem {
    background: transparent;
}

/* "Why?" — a text link, not a second button per row competing with the
   card's own CTA (MASTER §3: one primary per surface).  Same accent/size
   treatment as `#armoryCardCta`, one step smaller because it repeats. */
QWidget[aion2="true"] #armoryRecoWhyButton {
    background: transparent;
    color: {{accent}};
    border: {{border_width}}px solid transparent;
    border-radius: {{radius_sm}}px;
    padding: 0px {{space_1}}px;
    font-size: {{text_sm}}px;
    font-weight: {{font_weight_semibold}};
}

QWidget[aion2="true"] #armoryRecoWhyButton:hover {
    background-color: {{accent_soft}};
    border-color: {{accent}};
}

QWidget[aion2="true"] #armoryRecoWhyButton:checked {
    background-color: {{accent_soft}};
    border-color: {{accent}};
}

/* The ring sits on the control's own edge — the button already carries a
   1 px transparent border, so nothing moves when focus lands (§0b's rule,
   and the reason `#armoryCardCta:focus` re-states its padding inset). */
QWidget[aion2="true"] #armoryRecoWhyButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    border-radius: {{radius_sm}}px;
    padding: 0px {{space_1_inset}}px;
}

/* The expanded reasons: muted and indented, so the explanation reads as
   subordinate to the line it explains rather than as four more
   recommendations. */
QWidget[aion2="true"] #armoryRecoWhy {
    color: {{fg_muted}};
    font-size: {{text_xs}}px;
    padding-left: {{space_2}}px;
}
