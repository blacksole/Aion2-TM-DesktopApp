/* ---------------------------------------------------------------------
   7. Badges  (MASTER §3: 11 px caps, radius sm, *.soft fill, full-color
   text; schedule → secondary, MISSED → danger)
   ------------------------------------------------------------------ */

QWidget[aion2="true"] #scheduleDaily,
QWidget[aion2="true"] #scheduleWeekly,
QWidget[aion2="true"] #scheduleSeason,
QWidget[aion2="true"] #eventBadge,
QWidget[aion2="true"] #missedBadge,
QWidget[aion2="true"] #newBadge,
QWidget[aion2="true"] #priorityLow,
QWidget[aion2="true"] #priorityMedium,
QWidget[aion2="true"] #priorityMiddle,
QWidget[aion2="true"] #priorityHigh,
QWidget[aion2="true"] #ArcanaGradePill,
QWidget[aion2="true"] #GeniusLvlBadge,
QWidget[aion2="true"] #changelogHotfixBadge {
    border-radius: {{radius_sm}}px;
    padding: {{space_1}}px {{space_2}}px;
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_bold}};
    letter-spacing: {{letter_spacing_caps}};
    border: {{border_width}}px solid transparent;
}

QWidget[aion2="true"] #scheduleDaily,
QWidget[aion2="true"] #scheduleWeekly,
QWidget[aion2="true"] #scheduleSeason,
QWidget[aion2="true"] #ArcanaGradePill,
QWidget[aion2="true"] #GeniusLvlBadge {
    color: {{secondary}};
    background-color: {{secondary_soft}};
}

/* EVENT / NEW sit next to a priority badge on the same row, and `warn` was
   the priority colour too -- only the fill separated them (review F-17).
   MASTER §3 now specs these as `secondary`, the same family as the schedule
   badge: both answer "what KIND of entry is this", where priority answers
   "how urgent". */
QWidget[aion2="true"] #eventBadge,
QWidget[aion2="true"] #newBadge {
    color: {{secondary}};
    background-color: {{secondary_soft}};
}

QWidget[aion2="true"] #missedBadge,
QWidget[aion2="true"] #changelogHotfixBadge {
    color: {{danger}};
    background-color: {{danger_soft}};
}

/* MASTER §3, Badge: "priorité → texte seul".  A priority is on every single
   row, so a filled pill three rows deep turns the list into a colour chart
   -- the three that DO get a fill (schedule, MISSED, EVENT) are the ones
   that mean "not like the others".  Colour still carries the meaning
   (ok / warn / danger), the fill does not. */
QWidget[aion2="true"] #priorityLow,
QWidget[aion2="true"] #priorityMedium,
QWidget[aion2="true"] #priorityMiddle,
QWidget[aion2="true"] #priorityHigh {
    background-color: transparent;
    padding: {{space_1}}px 0px;
}

QWidget[aion2="true"] #priorityMedium,
QWidget[aion2="true"] #priorityMiddle {
    color: {{warn}};
}

QWidget[aion2="true"] #priorityHigh {
    color: {{danger}};
}

QWidget[aion2="true"] #priorityLow {
    color: {{ok}};
}

/* Schedule / priority / currency toggles — pill rules, colored by meaning
   when checked. */
QWidget[aion2="true"] #scheduleToggleBtn,
QWidget[aion2="true"] #priorityToggleLow,
QWidget[aion2="true"] #priorityToggleMiddle,
QWidget[aion2="true"] #priorityToggleHigh,
QWidget[aion2="true"] #currencyToggleKinah,
QWidget[aion2="true"] #currencyToggleAbyss {
    background-color: {{bg_elevated}};
    color: {{fg_secondary}};
    border: {{border_width}}px solid {{border}};
