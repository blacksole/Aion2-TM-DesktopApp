/* MASTER §3 primary: flat accent + fg_on_accent.  This is the
   single fix for audit D/C3's 1.81:1 white-on-cyan. */
QWidget[aion2="true"] #primaryButton,
QWidget[aion2="true"] #FlowSaveButton,
QWidget[aion2="true"] #emptyStateAction,
QWidget[aion2="true"] #toastActionButton {
