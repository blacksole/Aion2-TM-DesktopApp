/* =====================================================================
   Aion2 TM — QSS TEMPLATE  (« Aether Cockpit », design-system/aion2-tm/MASTER.md)

   ONE set of rules.  A theme is not another block, it is another set of
   token values: core/theme.build_qss(theme) substitutes every "curly-curly"
   placeholder below from core.theme.THEMES[theme].  There is deliberately no
   QWidget[theme="…"] selector left anywhere in this file — the 100 of them
   the old ui/styles.qss carried are exactly what made an accent change a
   six-place edit (audit A §7-1, D/M5).

   ASSET_PATH is replaced by the loader with the repo root (dev) or
   sys._MEIPASS (frozen), same as before.

   Conventions, all from MASTER:
     §3 primary   = accent fill + fg_on_accent text, never a gradient
     §3 pill      = bg_elevated / border / fg_secondary,
                    active accent_soft + accent border + fg
     §3 destructive = transparent + danger outline/text, hover danger_soft
     §2 focus.ring  = focus_ring_width px accent on every focusable widget
     §1 radii     = radius_sm inputs/pills/badges, radius_md cards/panels
   ===================================================================== */

/* ---------------------------------------------------------------------
   0. Base
   ------------------------------------------------------------------ */

/* The app's own widget tree, and nothing else.
   `QWidget[aion2="true"]` matches our three top-level windows (MainWindow,
   OverlayWindow, FlowMapWindow — they set the property in __init__); the
   descendant form matches everything inside them, including dialogs, since
   Qt's descendant matching walks parentWidget().  The bare form is listed
   too because a descendant selector never matches the ancestor itself. */
QWidget[aion2="true"],
QWidget[aion2="true"] QWidget {
    font-family: {{font_body}};
    font-size: {{text_base}}px;
    color: {{fg}};
}

QWidget[aion2="true"] QMainWindow,
QWidget[aion2="true"] QDialog {
    background-color: {{bg_window}};
}

QWidget[aion2="true"] QLabel {
    background: transparent;
}

/* ---------------------------------------------------------------------
   0b. Focus ring — MASTER §2 `focus.ring`, revised 2026-09-18.

   The ring is a BORDER on the control's own edge.  It was an `outline`
   before, which does not work: Qt cannot paint outside a widget's rect, so
   `outline` on a QWidget only recolours Fusion's PE_FrameFocusRect — a
   rectangle drawn around the *label* sub-rect, INSIDE the control and
   straight through the descenders of its text (visible in
   docs/audit-2026-09-18/shots/aether/app_focus_ring_detail.png: the
   focused pill showed a second box hugging the word and cutting the "g").
   `outline-offset` and the pill radius were both ignored.

   Two consequences drive the shape of everything below:

   * the rules must sit at ID specificity, because 157 `#objectName` rules
     in this file declare a border and an ID selector (100) outranks a
     type+pseudo one (11).  `#id:focus` (110) wins;
   * growing 1 px → `focus_ring_width` grows the widget's sizeHint, which
     would nudge its whole row on focus, so each rule gives the pixel back
     as padding.  QSS has no arithmetic: the compensated values are tokens
     (`space_2_inset` = `space_2` − `focus_inset`, core/theme.py).

   Controls whose resting padding is known take the full ring.  The tail at
   the bottom — bordered controls with padding this file does not set —
   takes the accent edge at its own border width instead, which changes no
   geometry at all.
   ------------------------------------------------------------------ */

/* Fusion draws its own focus rectangle inside the control; ours replaces
   it, so suppress it everywhere rather than end up with both. */
QWidget[aion2="true"],
QWidget[aion2="true"] QWidget {
    outline: none;
}

QWidget[aion2="true"] #tabButton:focus,
QWidget[aion2="true"] #filterButton:focus,
QWidget[aion2="true"] #toggleButton:focus,
QWidget[aion2="true"] #templateSourceTab:focus,
QWidget[aion2="true"] #minuteToggleButton:focus,
QWidget[aion2="true"] #GeniusSegBtn:focus,
QWidget[aion2="true"] #GeniusBoardTabBtn:focus,
QWidget[aion2="true"] #SkillFilterButton:focus,
QWidget[aion2="true"] #sortButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_2_inset}}px {{space_3_inset}}px;
    background-color: {{accent_soft}};
}

QWidget[aion2="true"] #topTabButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_3_inset}}px {{space_6_inset}}px;
    background-color: {{accent_soft}};
}

QWidget[aion2="true"] #dayButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_1_inset}}px {{space_2_inset}}px;
    background-color: {{accent_soft}};
}

QWidget[aion2="true"] #themeToggleButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_3_inset}}px {{space_4_inset}}px;
    background-color: {{accent_soft}};
}

QWidget[aion2="true"] #secondaryButton:focus,
QWidget[aion2="true"] #themeButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_1_inset}}px {{space_3_inset}}px;
    background-color: {{accent_soft}};
}

QWidget[aion2="true"] #settingsNavButton:focus,
QWidget[aion2="true"] #settingsSidebarButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_2_inset}}px {{space_3_inset}}px;
    background-color: {{accent_soft}};
}

QWidget[aion2="true"] #sidebarButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_3_inset}}px {{space_3_inset}}px;
    background-color: {{accent_soft}};
}

QWidget[aion2="true"] #emptyStateAction:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_2_inset}}px {{space_4_inset}}px;
    background-color: {{accent_soft}};
}

QWidget[aion2="true"] #scheduleToggleBtn:focus,
QWidget[aion2="true"] #priorityToggleLow:focus,
QWidget[aion2="true"] #priorityToggleMiddle:focus,
QWidget[aion2="true"] #priorityToggleHigh:focus,
QWidget[aion2="true"] #currencyToggleKinah:focus,
QWidget[aion2="true"] #currencyToggleAbyss:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    padding: {{space_1_inset}}px {{space_2_inset}}px;
    background-color: {{accent_soft}};
}

/* Accent-FILLED controls: an accent ring on an accent fill is
   invisible, which is worst on exactly the buttons a keyboard user
   reaches first (review F-9).  Ring in fg.on-accent instead. */
QWidget[aion2="true"] #primaryButton:focus,
QWidget[aion2="true"] #FlowSaveButton:focus,
QWidget[aion2="true"] #updateAvailableButton:focus {
    border: {{focus_ring_width}}px solid {{fg_on_accent}};
    padding: {{space_2_inset}}px {{space_4_inset}}px;
}

QWidget[aion2="true"] #toastActionButton:focus {
    border: {{focus_ring_width}}px solid {{accent}};
    border-radius: {{radius_sm}}px;
    padding: {{space_0_inset}}px {{space_2_inset}}px;
}

/* Cards carry a 1 px resting border and no QSS padding of their own
   (their layout owns the margins), so the ring is the edge colour. */
QWidget[aion2="true"] #taskCard:focus,
QWidget[aion2="true"] #statCard:focus,
QWidget[aion2="true"] #timerCard:focus,
QWidget[aion2="true"] #armoryCardRow:focus,
QWidget[aion2="true"] #FlowNodeCard:focus {
    border-color: {{accent}};
}

/* Tail: every other bordered control, accent edge at its own width. */
QWidget[aion2="true"] #BuildSwitcherCombo:focus,
QWidget[aion2="true"] #DeleteDialogCancelBtn:focus,
QWidget[aion2="true"] #DeleteDialogDangerBtn:focus,
QWidget[aion2="true"] #DeleteDialogOptionBtn:focus,
QWidget[aion2="true"] #FlowCancelButton:focus,
QWidget[aion2="true"] #FlowDeleteMapBtn:focus,
QWidget[aion2="true"] #FlowDoneButton:focus,
QWidget[aion2="true"] #FlowEditorBottomToggle:focus,
QWidget[aion2="true"] #FlowHomeBtn:focus,
QWidget[aion2="true"] #FlowIconButton:focus,
QWidget[aion2="true"] #FlowInput:focus,
QWidget[aion2="true"] #FlowMapCombo:focus,
QWidget[aion2="true"] #FlowModeButton:focus,
QWidget[aion2="true"] #FlowNewMapBtn:focus,
QWidget[aion2="true"] #FlowNodeAddButton:focus,
QWidget[aion2="true"] #FlowNodeAddHintButton:focus,
QWidget[aion2="true"] #FlowResetMapBtn:focus,
QWidget[aion2="true"] #FlowSymbolCombo:focus,
QWidget[aion2="true"] #FlowTextEdit:focus,
QWidget[aion2="true"] #FlowToolButton:focus,
QWidget[aion2="true"] #FlowZoomCombo:focus,
QWidget[aion2="true"] #GeniusLineCombo:focus,
QWidget[aion2="true"] #GuideDoneButton:focus,
QWidget[aion2="true"] #GuideEditButton:focus,
QWidget[aion2="true"] #ItemSetCombo:focus,
QWidget[aion2="true"] #ManualResetBtn:focus,
QWidget[aion2="true"] #OverlayCharBtn:focus,
QWidget[aion2="true"] #OverlayCheckBtn:focus,
QWidget[aion2="true"] #OverlayCountdownToggleBtn:focus,
QWidget[aion2="true"] #OverlayIconBtn:focus,
QWidget[aion2="true"] #PanelCloseButton:focus,
QWidget[aion2="true"] #PanelNavButton:focus,
QWidget[aion2="true"] #changelogVersionBtn:focus,
QWidget[aion2="true"] #checkButton:focus,
QWidget[aion2="true"] #ctColorSwatch:focus,
QWidget[aion2="true"] #deleteButton:focus,
QWidget[aion2="true"] #donateButton:focus,
QWidget[aion2="true"] #donateQrButton:focus,
QWidget[aion2="true"] #helpButton:focus,
QWidget[aion2="true"] #iconButton:focus,
QWidget[aion2="true"] #linkButton:focus,
QWidget[aion2="true"] #overlayToggleBtn:focus,
QWidget[aion2="true"] #pageIconButton:focus,
QWidget[aion2="true"] #priorityInput:focus,
QWidget[aion2="true"] #profileInput:focus,
QWidget[aion2="true"] #profileSwitchButton:focus,
QWidget[aion2="true"] #settingsCombo:focus,
QWidget[aion2="true"] #settingsComboBox:focus,
QWidget[aion2="true"] #settingsTimerCombo:focus,
QWidget[aion2="true"] #settingsTimeEdit:focus,
QWidget[aion2="true"] #settingsTimeInput:focus,
QWidget[aion2="true"] #smallIconButton:focus,
QWidget[aion2="true"] #templateButton:focus,
QWidget[aion2="true"] #updateDialogLaterBtn:focus {
    border-color: {{accent}};
}

/* Sub-controls and item views: an indicator or a row cannot carry a
   border of its own here, so they keep an accent edge too. */
QWidget[aion2="true"] QCheckBox::indicator:focus,
QWidget[aion2="true"] QRadioButton::indicator:focus {
    border: {{focus_ring_width}}px solid {{accent}};
}

QWidget[aion2="true"] QListWidget::item:focus,
QWidget[aion2="true"] QListView::item:focus,
QWidget[aion2="true"] QTreeView::item:focus,
QWidget[aion2="true"] QTableView::item:focus,
QWidget[aion2="true"] QTabBar::tab:focus {
    border: {{border_width}}px solid {{accent}};
}

/* ---------------------------------------------------------------------
   1. Menus, scrollbars, tooltips
   ------------------------------------------------------------------ */

QWidget[aion2="true"] QMenuBar {
    background-color: {{bg_overlay}};
    color: {{fg}};
    padding: {{space_1}}px;
    border-bottom: {{border_width}}px solid {{border}};
}

QWidget[aion2="true"] QMenuBar::item {
    padding: {{space_1}}px {{space_3}}px;
    border-radius: {{radius_sm}}px;
}

QWidget[aion2="true"] QMenuBar::item:selected {
    background-color: {{accent_soft}};
    color: {{fg}};
}

QWidget[aion2="true"] QMenu {
    background-color: {{bg_overlay}};
    color: {{fg}};
    border: {{border_width}}px solid {{border_strong}};
    border-radius: {{radius_md}}px;
}

QWidget[aion2="true"] QMenu::item {
    padding: {{space_2}}px {{space_6}}px;
}

QWidget[aion2="true"] QMenu::item:selected {
    background-color: {{accent_soft}};
    color: {{fg}};
}

/* Flat scrollbars, no arrow buttons — the platform's native ones clash
   with every one of the app's dark themes. */
QWidget[aion2="true"] QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QWidget[aion2="true"] QScrollBar::handle:vertical {
    background: {{border_strong}};
    border-radius: 5px;
    min-height: 24px;
}

QWidget[aion2="true"] QScrollBar::handle:vertical:hover {
    background: {{accent}};
}

QWidget[aion2="true"] QScrollBar::add-line:vertical,
QWidget[aion2="true"] QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QWidget[aion2="true"] QScrollBar::add-page:vertical,
QWidget[aion2="true"] QScrollBar::sub-page:vertical {
    background: none;
}

QWidget[aion2="true"] QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QWidget[aion2="true"] QScrollBar::handle:horizontal {
    background: {{border_strong}};
    border-radius: 5px;
    min-width: 24px;
}

QWidget[aion2="true"] QScrollBar::handle:horizontal:hover {
    background: {{accent}};
}

QWidget[aion2="true"] QScrollBar::add-line:horizontal,
QWidget[aion2="true"] QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QWidget[aion2="true"] QScrollBar::add-page:horizontal,
QWidget[aion2="true"] QScrollBar::sub-page:horizontal {
    background: none;
}

/* MASTER §1: the single allowed shadow surface. */
QToolTip {
    background-color: {{bg_overlay}};
    color: {{fg}};
    border: {{border_width}}px solid {{border_strong}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_3}}px;
    font-size: {{text_sm}}px;
    font-weight: {{font_weight_medium}};
}

/* ---------------------------------------------------------------------
   2. Header / titles / page chrome
   ------------------------------------------------------------------ */

QWidget[aion2="true"] #appIcon {
    background-color: {{accent}};
    color: {{fg_on_accent}};
    border-radius: {{radius_md}}px;
    padding: {{space_2}}px;
    font-family: {{font_display}};
    font-size: {{text_xl}}px;
    font-weight: {{font_weight_bold}};
}

QWidget[aion2="true"] #mainTitle {
    color: {{fg}};
    font-family: {{font_display}};
    font-size: {{text_display}}px;
    font-weight: {{font_weight_bold}};
}

QWidget[aion2="true"] #subtitle {
    color: {{fg_muted}};
    font-size: {{text_base}}px;
}

QWidget[aion2="true"] #PageTitle {
    color: {{fg}};
    font-family: {{font_display}};
    font-size: {{text_2xl}}px;
    font-weight: {{font_weight_bold}};
}

QWidget[aion2="true"] #PageSubtitle,
QWidget[aion2="true"] #sectionTitle {
    color: {{fg_secondary}};
    font-size: {{text_md}}px;
    font-weight: {{font_weight_semibold}};
}

QWidget[aion2="true"] #userLabel {
    color: {{fg_muted}};
    font-size: {{text_base}}px;
    font-weight: {{font_weight_semibold}};
    padding-right: {{space_2}}px;
}

QWidget[aion2="true"] #loginTitle {
    color: {{fg}};
    font-family: {{font_display}};
    font-size: {{text_2xl}}px;
    font-weight: {{font_weight_bold}};
}

QWidget[aion2="true"] #loginInfo {
    color: {{fg_secondary}};
    font-size: {{text_md}}px;
}

QWidget[aion2="true"] #footer {
    color: {{fg_muted}};
    border-top: {{border_width}}px solid {{border}};
    padding-top: {{space_3}}px;
}

QWidget[aion2="true"] #scrollArea,
QWidget[aion2="true"] #OverlayScroll {
    background: transparent;
    border: none;
}

QWidget[aion2="true"] #TopBar {
    background: transparent;
    border: none;
}

/* ---------------------------------------------------------------------
   3. Nav pills / tabs  (MASTER §3 "pill" — one tab style app-wide)
   ------------------------------------------------------------------ */

QWidget[aion2="true"] #tabButton,
QWidget[aion2="true"] #topTabButton,
QWidget[aion2="true"] #filterButton,
QWidget[aion2="true"] #sortButton,
QWidget[aion2="true"] #templateSourceTab,
QWidget[aion2="true"] #toggleButton,
QWidget[aion2="true"] #dayButton,
QWidget[aion2="true"] #minuteToggleButton,
QWidget[aion2="true"] #themeToggleButton,
QWidget[aion2="true"] #GeniusSegBtn,
QWidget[aion2="true"] #GeniusBoardTabBtn,
QWidget[aion2="true"] #SkillFilterButton {
    background-color: {{bg_elevated}};
    color: {{fg_secondary}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_3}}px;
    font-size: {{text_base}}px;
    font-weight: {{font_weight_semibold}};
}

QWidget[aion2="true"] #tabButton:hover,
QWidget[aion2="true"] #topTabButton:hover,
QWidget[aion2="true"] #filterButton:hover,
QWidget[aion2="true"] #sortButton:hover,
QWidget[aion2="true"] #templateSourceTab:hover,
QWidget[aion2="true"] #toggleButton:hover,
QWidget[aion2="true"] #dayButton:hover,
QWidget[aion2="true"] #minuteToggleButton:hover,
QWidget[aion2="true"] #themeToggleButton:hover,
QWidget[aion2="true"] #GeniusSegBtn:hover,
QWidget[aion2="true"] #GeniusBoardTabBtn:hover,
QWidget[aion2="true"] #SkillFilterButton:hover {
    border-color: {{border_strong}};
    color: {{fg}};
}

QWidget[aion2="true"] #tabButton[active="true"],
QWidget[aion2="true"] #topTabButton[active="true"],
QWidget[aion2="true"] #filterButton[active="true"],
QWidget[aion2="true"] #toggleButton[active="true"],
QWidget[aion2="true"] #dayButton[active="true"],
QWidget[aion2="true"] #sortButton:checked,
QWidget[aion2="true"] #templateSourceTab:checked,
QWidget[aion2="true"] #minuteToggleButton:checked,
QWidget[aion2="true"] #themeToggleButton:checked,
QWidget[aion2="true"] #GeniusSegBtn:checked,
QWidget[aion2="true"] #GeniusBoardTabBtn:checked,
QWidget[aion2="true"] #SkillFilterButton:checked {
    background-color: {{accent_soft}};
    color: {{fg}};
    border: {{border_width}}px solid {{accent}};
    /* No font-weight here.  MASTER §3 carries "active" on three signals --
       accent.soft fill, accent border, fg text -- and deliberately not on
       weight: QPushButton computes its sizeHint from the *widget* font, so
       a QSS-only bold paints text wider than the width Qt reserved and the
       label clips on both edges ("Priority" -> "rioritˌ" in the §3 gallery,
       tighter pills first because they carry space_2/space_3 padding). */
}

QWidget[aion2="true"] #topTabButton {
    font-size: {{text_lg}}px;
    padding: {{space_3}}px {{space_6}}px;
}

QWidget[aion2="true"] #dayButton {
    font-size: {{text_sm}}px;
    padding: {{space_1}}px {{space_2}}px;
}

QWidget[aion2="true"] #themeToggleButton {
    padding: {{space_3}}px {{space_4}}px;
    font-size: {{text_md}}px;
    text-align: left;
}

QWidget[aion2="true"] #pageIconButton {
    background-color: {{bg_elevated}};
    color: {{fg_secondary}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    font-size: {{text_xl}}px;
    font-weight: {{font_weight_bold}};
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
}

QWidget[aion2="true"] #pageIconButton:hover {
    border-color: {{accent}};
    color: {{fg}};
}

QWidget[aion2="true"] #pageIconButton:pressed {
    background-color: {{accent_soft}};
}

/* QTabWidget natives adopt the same pill style (MASTER §3). */
QWidget[aion2="true"] #settingsTabWidget,
QWidget[aion2="true"] #timerModeTabWidget {
    border: none;
    background: transparent;
}

QWidget[aion2="true"] #settingsTabWidget QTabBar::tab,
QWidget[aion2="true"] #timerModeTabWidget QTabBar::tab {
    background: {{bg_elevated}};
    color: {{fg_secondary}};
    border: {{border_width}}px solid {{border}};
    border-bottom: none;
    border-radius: {{radius_sm}}px {{radius_sm}}px 0 0;
    padding: {{space_2}}px {{space_6}}px;
    font-size: {{text_base}}px;
    font-weight: {{font_weight_semibold}};
    min-width: 110px;
}

QWidget[aion2="true"] #timerModeTabWidget QTabBar::tab {
    padding: {{space_1}}px {{space_3}}px;
    min-width: 60px;
}

QWidget[aion2="true"] #settingsTabWidget QTabBar::tab:selected,
QWidget[aion2="true"] #timerModeTabWidget QTabBar::tab:selected {
    background: {{accent_soft}};
    color: {{fg}};
    border: {{border_width}}px solid {{accent}};
    border-bottom: none;
}

QWidget[aion2="true"] #settingsTabWidget QTabBar::tab:hover:!selected,
QWidget[aion2="true"] #timerModeTabWidget QTabBar::tab:hover:!selected {
    background: {{bg_overlay}};
    color: {{fg}};
}

QWidget[aion2="true"] #settingsTabWidget::pane,
QWidget[aion2="true"] #timerModeTabWidget::pane {
    border: {{border_width}}px solid {{border}};
    border-radius: 0 {{radius_md}}px {{radius_md}}px {{radius_md}}px;
    background: transparent;
    padding: {{space_1}}px;
}

/* ---------------------------------------------------------------------
   4. Cards  (MASTER §3 "Carte": bg.elevated, 1 px border, radius md,
   padding 3 — a card has a surface LEVEL, never a shadow)
   ------------------------------------------------------------------ */

QWidget[aion2="true"] #statCard,
QWidget[aion2="true"] #addPanel,
QWidget[aion2="true"] #taskCard,
QWidget[aion2="true"] #timerCard,
QWidget[aion2="true"] #settingsRow,
QWidget[aion2="true"] #armoryCardRow,
QWidget[aion2="true"] #settingsThemeContainer,
QWidget[aion2="true"] #TaskProgressBar,
QWidget[aion2="true"] #profileCard,
QWidget[aion2="true"] #SkillDescCard,
QWidget[aion2="true"] #GeniusOwnedTile,
QWidget[aion2="true"] #DaevanionAccordionSection {
    background-color: {{bg_elevated}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_md}}px;
}

QWidget[aion2="true"] #settingsRow,
QWidget[aion2="true"] #armoryCardRow {
    min-height: 52px;
}

QWidget[aion2="true"] #armoryCardRow:hover {
    background-color: {{bg_overlay}};
    border-color: {{accent}};
}

QWidget[aion2="true"] #timerCard {
    max-width: 190px;
    min-height: 72px;
}

QWidget[aion2="true"] #taskCard[selected="true"] {
    border: {{focus_ring_width}}px solid {{accent}};
    background-color: {{accent_soft}};
}

/* Completed: title goes muted and the check goes ok (MASTER §3).  The
   old rule here was `opacity: 0.6`, which QSS silently ignores on a
   widget — the state simply never showed. */
QWidget[aion2="true"] #taskCard[completed="true"] {
    background-color: {{bg_surface}};
    border: {{border_width}}px solid {{border}};
}

QWidget[aion2="true"] #taskCard[completed="true"] #taskTitle {
    color: {{fg_muted}};
    text-decoration: line-through;
}

QWidget[aion2="true"] #taskCard[completed="true"] #checkButton {
    color: {{ok}};
}

QWidget[aion2="true"] #statTitle {
    color: {{fg_muted}};
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_semibold}};
    letter-spacing: {{letter_spacing_caps}};
}

QWidget[aion2="true"] #taskTitle {
    color: {{fg}};
    font-size: {{text_md}}px;
    font-weight: {{font_weight_semibold}};
}

QWidget[aion2="true"] #taskDescription {
    color: {{fg_muted}};
    font-size: {{text_sm}}px;
}

QWidget[aion2="true"] #taskSection {
    background: transparent;
    border: none;
}

QWidget[aion2="true"] #checkButton {
    color: {{fg_muted}};
    background: transparent;
    border: none;
    font-size: {{text_2xl}}px;
}

QWidget[aion2="true"] #checkButton:hover {
    color: {{ok}};
}

/* MASTER §3 "Bouton destructif": outline + text danger, no fill. */
QWidget[aion2="true"] #deleteButton {
    background: transparent;
    color: {{danger}};
    border: none;
    font-size: {{text_lg}}px;
}

QWidget[aion2="true"] #deleteButton:hover {
    color: {{danger}};
    background-color: {{danger_soft}};
    border-radius: {{radius_sm}}px;
}

/* ---------------------------------------------------------------------
   5. Fields  (MASTER §3 "Champ": bg.input, border, focus accent,
   placeholder fg.muted — fixes audit D/C3's 2.48:1 placeholder)
   ------------------------------------------------------------------ */

QWidget[aion2="true"] QLineEdit,
QWidget[aion2="true"] QTextEdit,
QWidget[aion2="true"] QPlainTextEdit,
QWidget[aion2="true"] QSpinBox,
QWidget[aion2="true"] QTimeEdit,
QWidget[aion2="true"] QDateTimeEdit {
    background-color: {{bg_input}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_3}}px;
    color: {{fg}};
    font-size: {{text_base}}px;
    placeholder-text-color: {{fg_muted}};
}

/* MASTER §3 "Champ": a focused field's own border goes accent, on top of
   the outline ring above.  border-COLOR, not the `border` shorthand: the
   shorthand would also change the width, so the field would grow 1 px and
   nudge its whole row on focus. */
QWidget[aion2="true"] QLineEdit:focus,
QWidget[aion2="true"] QTextEdit:focus,
QWidget[aion2="true"] QPlainTextEdit:focus {
    border-color: {{accent}};
}

QWidget[aion2="true"] QLineEdit:disabled,
QWidget[aion2="true"] QTextEdit:disabled,
QWidget[aion2="true"] QPlainTextEdit:disabled {
    color: {{fg_muted}};
    background-color: {{bg_surface}};
    border-color: {{border}};
}

QWidget[aion2="true"] #profileInput {
    background-color: {{bg_input}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_3}}px;
    color: {{fg}};
    font-size: {{text_base}}px;
    min-width: 220px;
    max-width: 320px;
}

QWidget[aion2="true"] #settingsLineEditReadOnly {
    background-color: {{bg_surface}};
    color: {{fg_muted}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_3}}px;
    font-family: {{font_mono}};
    font-size: {{text_sm}}px;
}

QWidget[aion2="true"] #settingsPathLabel {
    background-color: {{bg_input}};
    color: {{fg_secondary}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_1}}px {{space_2}}px;
    font-family: {{font_mono}};
    font-size: {{text_sm}}px;
}

QWidget[aion2="true"] QComboBox {
    background-color: {{bg_input}};
    color: {{fg}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_3}}px;
}

/* NO `color` and NO `selection-color` here, and this is load-bearing.
   A QSS `color` on an item view overrides every QStandardItem's own
   setForeground() unconditionally, which flattens per-rarity item colours
   to one flat slate.  ItemDatabase/styles.qss:104-112 removed exactly this
   declaration on 2026-09-18's predecessor date (2026-08-29) with the user
   report attached ("Grade/Rarity dropdown items showed plain white instead
   of their per-rarity color") -- and since the two sheets MERGE per
   property (Qt weights depth above specificity, so the deeper window sheet
   wins only the properties it actually declares), putting `color` back on
   the application sheet silently re-broke that fix in every Armory
   dropdown.  Item text colour comes from the palette instead
   (QPalette::Text / ::HighlightedText, both token-derived in
   core.theme.build_palette), which is what ItemDatabase's own comment says
   it relies on. */
QWidget[aion2="true"] QComboBox QAbstractItemView {
    background-color: {{bg_overlay}};
    border: {{border_width}}px solid {{border}};
    selection-background-color: {{accent_soft}};
}

QWidget[aion2="true"] QComboBox QAbstractItemView::item {
    padding: {{space_2}}px;
}

QWidget[aion2="true"] QComboBox#priorityInput {
    font-weight: {{font_weight_bold}};
}

QWidget[aion2="true"] #priorityInput,
QWidget[aion2="true"] #settingsCombo,
QWidget[aion2="true"] #settingsTimerCombo,
QWidget[aion2="true"] #ItemSetCombo,
QWidget[aion2="true"] #BuildSwitcherCombo,
QWidget[aion2="true"] #GeniusLineCombo {
    background-color: {{bg_input}};
    color: {{fg}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_8}}px {{space_2}}px {{space_3}}px;
    font-size: {{text_base}}px;
    font-weight: {{font_weight_semibold}};
    min-height: 20px;
}

QWidget[aion2="true"] #priorityInput:hover,
QWidget[aion2="true"] #settingsCombo:hover,
QWidget[aion2="true"] #settingsTimerCombo:hover {
    border-color: {{accent}};
}

/* Advanced Timer's Start/Anchor/Interval combos (Shugo/Rift) -- same base
   as #settingsCombo above, but these show timer values (start minute,
   interval), which MASTER's type table assigns font.mono, same as the
   Reset Timer section's QTimeEdit/QDateEdit fields (#settingsTimeInput)
   right above them on the same page. Plain #settingsCombo stays body-font
   (it also serves Build/Item-Set/Stat-name dropdowns, which are text, not
   timer values) -- User-reported, 2026-09-23: the two number styles sitting
   in different fonts on the same settings page read as visually broken. */
QWidget[aion2="true"] #settingsTimerCombo {
    font-family: {{font_mono}};
}

QWidget[aion2="true"] #priorityInput:disabled {
    color: {{fg_muted}};
    background-color: {{bg_surface}};
    border-color: {{border}};
}

QWidget[aion2="true"] #priorityInput QLineEdit {
    background: transparent;
    color: {{fg}};
    border: none;
    padding: 0;
}

QWidget[aion2="true"] #priorityInput::drop-down,
QWidget[aion2="true"] #FlowMapCombo::drop-down {
    border: none;
    width: 24px;
    background: transparent;
}

QWidget[aion2="true"] #priorityInput QAbstractItemView {
    background-color: {{bg_overlay}};
    border: {{border_width}}px solid {{border}};
    selection-background-color: {{accent_soft}};
    selection-color: {{fg}};
    color: {{fg}};
    padding: {{space_1}}px;
}

/* Dropdown chevron — a Lucide chevron, pre-tinted per theme (MASTER §3).
   Was `assets/icons/arrow_down_orange.png`: one baked ORANGE bitmap for all
   six themes, so a combo box on Abyss, Emerald or Void carried a warm accent
   that belongs to none of them (MASTER « Décisions différées », review D/m3).
   QSS `image: url()` cannot tint, so the file itself has to be the right
   colour -- `{{name}}` is the active theme's own name, and the 6 × 4 files it
   selects between are generated from `fg.muted` by
   scripts/gen_tinted_icons.py (see its docstring for why build time and not
   a runtime cache). */
QWidget[aion2="true"] #priorityInput::down-arrow,
QWidget[aion2="true"] #settingsCombo::down-arrow,
QWidget[aion2="true"] #settingsTimerCombo::down-arrow,
QWidget[aion2="true"] #FlowZoomCombo::down-arrow,
QWidget[aion2="true"] #FlowSymbolCombo::down-arrow {
    image: url(ASSET_PATH/assets/icons/lucide/tinted/{{name}}/chevron-down.svg);
    width: 14px;
    height: 14px;
    border: none;
    background: transparent;
}

/* Hover: the theme's OWN accent.  This is the variant that makes the
   per-theme folders earn their keep -- `fg.muted` is not a token a theme may
   redefine (MASTER §2), so the resting chevron is the same grey everywhere,
   while this one is cyan / teal / orange / lavender / white / violet.  The
   control gets back the splash of colour the orange PNG used to give it,
   only now it is the colour of the theme the user actually picked.

   The pseudo-state goes on the SUBCONTROL (`::down-arrow:hover`), never on
   the widget (`:hover::down-arrow`).  Both forms parse, and the second one
   is what this rule was written as first -- it makes Qt draw the image a
   SECOND time, unsized and unpositioned, on top of the combo's own text: a
   half-clipped chevron that reads as a stray "✓" next to the value.  It is
   visible in every theme and in every combo, with no hover involved.  Same
   family as the `outline` lesson in MASTER's focus-ring note: the QSS
   *parses*, and Qt's idea of what it means is not CSS's. */
QWidget[aion2="true"] #priorityInput::down-arrow:hover,
QWidget[aion2="true"] #settingsCombo::down-arrow:hover,
QWidget[aion2="true"] #settingsTimerCombo::down-arrow:hover,
QWidget[aion2="true"] #FlowZoomCombo::down-arrow:hover,
QWidget[aion2="true"] #FlowSymbolCombo::down-arrow:hover {
    image: url(ASSET_PATH/assets/icons/lucide/tinted/{{name}}/chevron-down-accent.svg);
}

QWidget[aion2="true"] #settingsTimeEdit,
QWidget[aion2="true"] #settingsComboBox {
    background-color: {{bg_input}};
    color: {{fg}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_3}}px;
    min-height: 34px;
    font-size: {{text_md}}px;
}

QWidget[aion2="true"] #settingsTimeEdit {
    min-width: 90px;
    font-family: {{font_mono}};
}

QWidget[aion2="true"] #settingsComboBox {
    min-width: 140px;
}

QWidget[aion2="true"] #settingsComboBox QAbstractItemView {
    background-color: {{bg_overlay}};
    color: {{fg}};
    selection-background-color: {{accent_soft}};
    selection-color: {{fg}};
}

QWidget[aion2="true"] #settingsTimeInput {
    background-color: {{bg_input}};
    color: {{fg}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: {{space_2}}px {{space_3}}px;
    font-family: {{font_mono}};
    font-size: {{text_base}}px;
    font-weight: {{font_weight_semibold}};
    min-height: 20px;
}

QWidget[aion2="true"] #settingsTimeInput::up-button,
QWidget[aion2="true"] #settingsTimeInput::down-button {
    width: 22px;
    border: none;
    background: transparent;
}

QWidget[aion2="true"] #settingsTimeInput::up-button:hover,
QWidget[aion2="true"] #settingsTimeInput::down-button:hover {
    background-color: {{accent_soft}};
    border-radius: {{radius_sm}}px;
}

/* Same story as the combo chevron above: the spin box's two arrows were the
   orange PNG pair, now the theme's own Lucide chevrons. */
QWidget[aion2="true"] #settingsTimeInput::up-arrow {
    image: url(ASSET_PATH/assets/icons/lucide/tinted/{{name}}/chevron-up.svg);
    width: 10px;
    height: 10px;
}

QWidget[aion2="true"] #settingsTimeInput::down-arrow {
    image: url(ASSET_PATH/assets/icons/lucide/tinted/{{name}}/chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* The two spin buttons already light up `accent.soft` on hover (above); the
   arrow inside follows, same accent variant as the combo chevron. */
QWidget[aion2="true"] #settingsTimeInput::up-arrow:hover {
    image: url(ASSET_PATH/assets/icons/lucide/tinted/{{name}}/chevron-up-accent.svg);
}

QWidget[aion2="true"] #settingsTimeInput::down-arrow:hover {
    image: url(ASSET_PATH/assets/icons/lucide/tinted/{{name}}/chevron-down-accent.svg);
}

/* Checkbox indicator — checked reads as the accent, MASTER §3. */
QWidget[aion2="true"] QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: {{border_width}}px solid {{border_strong}};
    border-radius: {{radius_sm}}px;
    background: {{bg_input}};
}

QWidget[aion2="true"] QCheckBox::indicator:hover {
    border: {{border_width}}px solid {{accent}};
}

QWidget[aion2="true"] QCheckBox::indicator:checked {
    background: {{accent}};
    border: {{border_width}}px solid {{accent}};
}

QWidget[aion2="true"] #settingsCheckbox,
QWidget[aion2="true"] #eventCheckBox {
    color: {{fg}};
    font-size: {{text_md}}px;
    padding: {{space_2}}px;
    min-height: 34px;
}

QWidget[aion2="true"] #settingsLabel,
QWidget[aion2="true"] #settingsInlineLabel,
QWidget[aion2="true"] #FieldLabel {
    color: {{fg}};
    font-size: {{text_md}}px;
    min-height: 28px;
}

QWidget[aion2="true"] #settingsDescription,
QWidget[aion2="true"] #settingsSectionDescription,
QWidget[aion2="true"] #resetHintLabel {
    color: {{fg_muted}};
    font-size: {{text_base}}px;
    padding-right: {{space_1}}px;
}

