/* ---------------------------------------------------------------------
   14. Tables  (MASTER §3: caps muted headers, alternating surface levels,
   mono right-aligned numbers)
   ------------------------------------------------------------------ */

QWidget[aion2="true"] QHeaderView::section {
    background-color: {{bg_surface}};
    color: {{fg_muted}};
    border: none;
    border-bottom: {{border_width}}px solid {{border}};
    padding: {{space_2}}px {{space_3}}px;
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_semibold}};
    letter-spacing: {{letter_spacing_caps}};
}

/* Same reason as QComboBox QAbstractItemView above: no `color` and no
   `selection-color` on an item view, ever -- either one overrides every
   item's own setForeground() unconditionally.  Item text comes from
   QPalette::Text / ::HighlightedText, both token-derived. */
QWidget[aion2="true"] QTableView,
QWidget[aion2="true"] QTreeView,
QWidget[aion2="true"] QListView {
    background-color: {{bg_surface}};
    alternate-background-color: {{bg_elevated}};
    border: {{border_width}}px solid {{border}};
    border-radius: {{radius_md}}px;
    gridline-color: {{border}};
    selection-background-color: {{accent_soft}};
}

QWidget[aion2="true"] QTableView::item,
QWidget[aion2="true"] QTreeView::item,
QWidget[aion2="true"] QListView::item {
    padding: {{space_1}}px {{space_2}}px;
}

QWidget[aion2="true"] QTableView::item:selected,
QWidget[aion2="true"] QTreeView::item:selected,
QWidget[aion2="true"] QListView::item:selected {
    background-color: {{accent_soft}};
}

/* The QDateEdit popup calendar (Settings -> Timers -> Season End).

   It is a separate Qt::Popup top-level with no widget parent, so it never
   carries aion2="true" and the scoped rules above cannot reach it.  Both
   blocks below are deliberately unscoped and allow-listed; there is exactly
   one QCalendarWidget in the app and the Armory has none (grepped), so
   nothing of ours can leak into its windows.

   History, so the next person does not retry it: this used to be a
   min-width/min-height floor plus item padding, trying to stop the day
   numbers eliding to "...".  Neither works.  The grid's columns are
   `Stretch` -- they divide the calendar's width among themselves and ignore
   any per-section size -- so the only lever is the calendar's own minimum
   width, which has to be computed from the font metrics.  QSS cannot
   measure a font, so the sizing lives in ui/widgets/calendar_popup.py and
   only colour stays here.  Measured before the fix: every column 18px wide
   regardless of font size, so "30" stopped fitting at ~12pt (DPI scaling
   alone reaches that) while single-digit days kept rendering. */
QCalendarWidget {
    background-color: {{bg_overlay}};
    color: {{fg}};
    /* `border.strong`, not `border`: a popup floats over a card, and the
       two surfaces below it differ by only 1.08-1.13:1 (measured across the
       six themes), so the edge is what separates them, not the fill.
       MASTER §1 also defines `shadow.popup` for exactly this case; it is
       applied as a QGraphicsDropShadowEffect in
       ui/widgets/calendar_popup.py, because Qt cannot draw a CSS shadow on
       a Qt::Popup. */
    border: {{border_width}}px solid {{border_strong}};
    border-radius: {{radius_md}}px;
}

/* No `color` on the day grid.  MASTER §4-8: a QSS `color` on an item view
   overrides the per-item setForeground(), which is how the weekend and the
   neighbouring months are greyed (ui/widgets/calendar_popup.py writes them
   as QTextCharFormat).  With `color` here, the first week row rendered at
   full `fg` while the identical format further down appeared to work --
   the paint order made it look like a stray row rather than a flattened
   column of formats.  Selection colours are safe: they are separate
   properties Qt reads for the highlight only. */
QCalendarWidget QWidget {
    background-color: {{bg_overlay}};
    selection-background-color: {{accent}};
    selection-color: {{fg_on_accent}};
    border: none;
    outline: none;
}

QWidget[aion2="true"] #StatRowCell,
