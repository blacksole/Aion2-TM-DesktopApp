/* ════════════════════════════════════════════════════════════════════════
   PART 2 — the rules that replaced this module's inline stylesheets
   (tokenization wave, 2026-09-18).

   ItemDatabase/app.py used to push 96 `setStyleSheet(...)` calls onto
   widgets at build time.  Three are left, and all three deliver THIS file
   to a window (create_window / ensure_loadout_window /
   open_crafting_calculator).  Everything else became an objectName, a
   dynamic property, and a rule here — which is what MASTER §4-4 asks for,
   and also what makes a theme switch work at all: an inline sheet is the
   deepest sheet Qt knows, so it won a property outright and no re-render
   could reach it.

   Two conventions carry most of it:

     [variant="…"]   a sub-shape of a widget that already has an
                     objectName (a smaller #DetailInfo, a bigger
                     #DetailHeader).  Specificity 110 beats the id rule's
                     100, so the variant refines instead of replacing.

     [dataColor="<kind>:<key>"]  a MASTER §4-4 data colour, set by
                     app.py's _set_data_color().  The generic
                     `*[dataColor=…]` rules at the end of this block carry
                     the colour; a widget whose own id rule declares a
                     `color` (#SkillFilterButton, #DetailInfo, …) gets an
                     id-qualified copy, and those copies are LAST in the
                     file on purpose: they tie with `#id:hover` /
                     `#id:checked` at 110 and win on order, which is how
                     the legacy inline sheet behaved (it beat every state
                     rule, so a checked rarity pill kept its rarity
                     colour rather than turning accent).
   ════════════════════════════════════════════════════════════════════════ */

/* QAbstractScrollArea's viewport paints its own QPalette::Base ground
   under Fusion — a light grey no outer rule reaches, which is why twelve
   call sites set `background: transparent` on the viewport by hand.  One
   objectName, one rule.  Also used for the two plain containers that
   needed the same thing. */
#TransparentPane {
    background: transparent;
}

/* ── item tiles and material rows ──────────────────────────────────── */

#GradeTileName {
    font-weight: {{font_weight_semibold}};
    font-size: {{text_xs}}px;
}

#TileMetaLabel {
    color: {{fg_muted}};
    font-size: 10px;
}

#MaterialQtyHighlight {
    color: {{ok}};
    font-weight: {{font_weight_bold}};
}

#SimGradeLabel {
    color: {{fg_muted}};
    font-weight: {{font_weight_bold}};
}

/* Clickable rows of the "which recipe?" context menu. */
#CraftMenuRow {
    padding: 4px 20px;
    background: transparent;
}

#CraftMenuRow:hover {
    background-color: {{accent|0.12}};
}

/* The 12-tier combo's own popup.  Restated instead of inherited: the
   generic `QComboBox QAbstractItemView` rules are two selectors deep and
   this popup needs roomier rows than the 4-row filters it shares them
   with (User-reported, 2026-09-12: the 12-tier list looked cramped). */
#TierComboPopup {
    background-color: {{bg_surface}};
    border: 1px solid {{border}};
    selection-background-color: {{accent|0.25}};
    padding: 4px;
}

#TierComboPopup::item {
    padding: 6px 10px;
}

/* ── two title variants of #DetailHeader ───────────────────────────── */

#DetailHeader[variant="large"] {
    font-size: 22px;
}

#DetailHeader[variant="medium"] {
    font-size: {{text_xl}}px;
}

#DetailInfo[variant="compact"] {
    font-size: {{text_xs}}px;
}

#DetailInfo[variant="dim"] {
    font-size: {{text_xs}}px;
    color: {{fg_muted|0.65}};
}

#EquipSectionLabel[variant="compact"] {
    font-size: 10px;
}

/* ── class picker ──────────────────────────────────────────────────── */

#ClassPickerEmoji {
    font-size: 48px;
    background: transparent;
}

#ClassPickerName {
    font-weight: {{font_weight_bold}};
    font-size: {{text_md}}px;
    background: transparent;
}

/* ── skill lists ───────────────────────────────────────────────────── */

#SkillTypeLabel {
    font-weight: {{font_weight_bold}};
    font-size: {{text_xs}}px;
}

#SkillListDivider {
    background-color: {{fg_muted|0.25}};
    border: none;
}

#SkillCardTypeLabel {
    font-size: 10px;
    font-weight: {{font_weight_bold}};
    letter-spacing: 1px;
}

/* Kind-of-skill / kind-of-damage badge (_make_type_badge). */
#SkillTypeBadge {
    border-radius: 8px;
    padding: 2px 10px;
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_bold}};
}

/* ── substat accordion headers ─────────────────────────────────────── */
/* Four buckets, four accents.  They used to be four rgb() triplets passed
   as strings through a nested function.  offensive / defensive / skills are
   OUR categories, so they take tokens; `pvp` takes the PvP *data* colour
   (core.theme.GEAR_TYPE_COLORS), because the legacy rose rgb(244,114,182)
   is that colour to within Δ(4,3,5) and "PvP" already means #fb7185
   everywhere else in this window -- mapping it to {secondary} was a
   pink→violet shift of Δ(77,25,68) (review G, M10). */

#SubstatSectionHeader {
    padding: 4px 10px;
    border: none;
    border-radius: 6px;
    font-weight: {{font_weight_bold}};
    font-size: {{text_xs}}px;
    text-align: left;
}

#SubstatSectionHeader[bucket="offensive"] {
    background-color: {{accent|0.18}};
    color: {{accent}};
}

#SubstatSectionHeader[bucket="defensive"] {
    background-color: {{ok|0.18}};
    color: {{ok}};
}

#SubstatSectionHeader[bucket="pvp"] {
    background-color: {{data.gear_type.PvP|0.18}};
    color: {{data.gear_type.PvP}};
}

#SubstatSectionHeader[bucket="skills"] {
    background-color: {{warn|0.18}};
    color: {{warn}};
}

/* ── the four translucent card tooltips ────────────────────────────── */
/* Daevanion node, skill, Arcana card, Arcana set bonus.  All four are
   custom-painted popups (_TranslucentCardTooltip) whose *contents* were
   styled inline, label by label. */

#TooltipTitle {
    font-size: 15px;
    font-weight: {{font_weight_bold}};
    color: {{fg}};
    background: transparent;
    border: none;
}

#TooltipMeta,
#TooltipStats {
    font-size: {{text_sm}}px;
    color: {{fg_muted}};
    background: transparent;
    border: none;
    border-top: 1px solid {{fg_muted|0.24}};
    padding-top: 8px;
}

#TooltipDesc {
    font-size: {{text_sm}}px;
    color: {{fg_secondary}};
    background: transparent;
    border: none;
}

#TooltipLordLine {
    font-size: {{text_xs}}px;
    background: transparent;
    border: none;
    border-bottom: 1px solid {{fg_muted|0.24}};
    padding-bottom: 8px;
}

#TooltipEffectRow {
    background: {{bg_surface|0.6}};
    border: 1px solid {{fg_muted|0.2}};
    border-radius: 8px;
}

#TooltipEffectLabel {
    font-size: {{text_sm}}px;
    color: {{fg_secondary}};
    background: transparent;
    border: none;
}

#TooltipEffectValue {
    font-size: {{text_sm}}px;
    font-weight: {{font_weight_bold}};
    color: {{accent}};
    background: transparent;
    border: none;
}

#TooltipColumnHead {
    font-size: 10px;
    font-weight: {{font_weight_bold}};
    letter-spacing: 1px;
    background: transparent;
    border: none;
}

#TooltipSkillRow {
    font-size: {{text_xs}}px;
    background: transparent;
    border: none;
}

/* Grade / skill-type pill at the top of a tooltip.  Chrome here, colour
   from [dataColor] below. */
#TooltipGradePill,
#TooltipTypePill {
    font-size: 10.5px;
    font-weight: {{font_weight_bold}};
    letter-spacing: 1px;
    padding: 2px 8px;
    border-radius: 9px;
    border: none;
}

/* Node status, five states (was a (colour, alpha) table in Python). */
#TooltipStatusPill {
    font-size: {{text_sm}}px;
    font-weight: {{font_weight_semibold}};
    border-radius: 8px;
    padding: 8px 10px;
    border: none;
}

#TooltipStatusPill[status="start"],
#TooltipStatusPill[status="active"] {
    background: {{accent|0.15}};
    color: {{accent}};
}

#TooltipStatusPill[status="available"] {
    background: {{ok|0.14}};
    color: {{ok}};
}

#TooltipStatusPill[status="locked"] {
    background: {{fg_muted|0.12}};
    color: {{fg_muted}};
}

#TooltipStatusPill[status="no_points"] {
    background: {{danger|0.14}};
    color: {{danger}};
}

/* ── Arcana ────────────────────────────────────────────────────────── */

#ArcanaSetBonusTitle {
    font-size: {{text_base}}px;
    font-weight: {{font_weight_bold}};
    color: {{accent}};
    background: transparent;
    border: none;
}

#ArcanaSetBonusLine {
    font-size: {{text_sm}}px;
    color: {{fg}};
    background: transparent;
    border: none;
}

#ArcanaSetInfoDot {
    border: 1.5px solid {{fg_muted}};
    border-radius: 7px;
    color: {{fg_muted}};
    font-size: 9px;
    font-weight: 800;
    background: transparent;
}

#ArcanaCardTypeTile {
    background: {{bg_surface|0.75}};
    border: 2px solid {{border_strong}};
    border-radius: 8px;
}

#ArcanaCardTypeTile[assigned="true"] {
    border-color: {{accent|0.7}};
}

#ArcanaThemeOption {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
}

#ArcanaThemeOption:hover {
    background: {{fg_muted|0.1}};
}

#ArcanaThemeRadio::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 2px solid {{fg_muted|0.65}};
    background: transparent;
}

#ArcanaThemeRadio::indicator:disabled {
    border-color: {{fg_muted|0.35}};
}

#ArcanaThemeOptionLord {
    font-size: 12.5px;
    font-weight: {{font_weight_semibold}};
    color: {{fg}};
    background: transparent;
    border: none;
}

#ArcanaSeasonButton {
    background: {{bg_elevated}};
    border: 1px solid {{border}};
    border-radius: 9px;
    padding: 9px 8px;
    font-size: {{text_sm}}px;
    font-weight: {{font_weight_semibold}};
    color: {{fg}};
}

#ArcanaSeasonButton:checked {
    background: {{accent|0.1}};
    border-color: {{accent}};
    color: {{accent}};
}

#ArcanaSeasonButton:disabled {
    color: {{fg_muted|0.65}};
}

#ArcanaThemeHint {
    color: {{fg_muted}};
    font-size: {{text_sm}}px;
}

#ArcanaSeasonLabel,
#ArcanaThemeColumnHead {
    font-weight: {{font_weight_bold}};
    font-size: {{text_xs}}px;
    letter-spacing: 1px;
    color: {{fg_muted|0.65}};
}

#ArcanaCardTypeName {
    font-size: {{text_base}}px;
    font-weight: {{font_weight_semibold}};
}

#ArcanaReasonLabel {
    color: {{fg_muted}};
    font-size: {{text_xs}}px;
}

#ArcanaLeftoverHeader {
    color: {{fg_muted}};
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_bold}};
    margin-top: 4px;
}

#ArcanaMaxHint {
    color: {{fg_muted|0.65}};
    font-size: 10px;
}

/* ── Genius Insight ────────────────────────────────────────────────── */

#GeniusOwnedName[variant="plain"] {
    color: {{fg}};
}

#GeniusPetTitle[active="false"] {
    font-weight: {{font_weight_semibold}};
}

/* ── Build Compare ─────────────────────────────────────────────────── */

#CompareValueBetter {
    color: {{ok}};
    font-weight: {{font_weight_bold}};
}

#CompareValueWorse {
    color: {{danger}};
    font-weight: {{font_weight_bold}};
}

/* ── Item Compare (ItemCompareDialog) ──────────────────────────────────
   Winner/loser colours are Build Compare's pair above -- ok / danger,
   tobia's call 2026-09-24 -- so both compare views read alike.  The
   arrow in the text (▲/▼) carries the same information for anyone who
   cannot tell the two apart: ok vs danger is 1.59:1 in luminance.       */

#CompareBody {
    background-color: {{bg_surface}};
}

#CompareTitle {
    font-size: {{text_lg}}px;
    font-weight: {{font_weight_semibold}};
}

#CompareSwap {
    color: {{fg_secondary}};
    background: transparent;
    border: 1px solid {{border}};
    border-radius: {{radius_sm}}px;
    padding: 4px 12px;
}

#CompareSwap:hover {
    color: {{fg}};
    border-color: {{border_strong}};
}

#CompareCard {
    background-color: {{bg_elevated}};
    border: 1px solid {{border}};
    border-radius: {{radius_md}}px;
}

#CompareIcon {
    background-color: {{bg_overlay}};
    border-radius: {{radius_sm}}px;
}

#CompareItemName {
    font-size: {{text_md}}px;
    font-weight: {{font_weight_semibold}};
}

#CompareItemMeta {
    color: {{fg_muted}};
    font-size: {{text_sm}}px;
}

#CompareVs {
    color: {{fg_muted}};
    font-weight: {{font_weight_semibold}};
    padding: 0 4px;
}

#CompareSummary {
    color: {{fg_secondary}};
}

#CompareNote {
    color: {{fg_muted}};
    font-size: {{text_sm}}px;
}

#CompareSection {
    color: {{fg_secondary}};
    font-size: {{text_xs}}px;
    font-weight: {{font_weight_semibold}};
    letter-spacing: 1px;
    padding-top: 6px;
}

#CompareTable {
    background-color: {{bg_elevated}};
    border: 1px solid {{border}};
    border-radius: {{radius_md}}px;
}

#CompareHead {
    color: {{fg_muted}};
    font-size: {{text_xs}}px;
    padding: 8px 10px;
    border-bottom: 1px solid {{border}};
}

#CompareStripe {
    background-color: {{bg_overlay}};
    border: none;
}

#CompareCell,
#CompareDelta {
    background: transparent;
    padding: 7px 10px;
}

#CompareCell[state="win"] {
    color: {{ok}};
    font-weight: {{font_weight_bold}};
}

#CompareCell[state="lose"] {
    color: {{danger}};
    font-weight: {{font_weight_bold}};
}

#CompareCell[state="absent"] {
    color: {{fg_muted}};
}

#CompareCell[state="pool"] {
    color: {{fg_secondary}};
}

#CompareDelta {
    font-size: {{text_sm}}px;
}

#CompareDelta[state="up"] {
    color: {{ok}};
}

#CompareDelta[state="down"] {
    color: {{danger}};
}

#CompareDelta[state="flat"] {
    color: {{fg_muted}};
}

#CompareToggle {
    color: {{accent}};
    background: transparent;
    border: none;
    padding: 2px 0;
    text-align: left;
}

#CompareToggle:hover {
    text-decoration: underline;
}

/* ── Equip panel: the item plate, ringed in the item's rarity ──────── */

#EquipItemIconLabel {
    background-color: {{bg_surface|0.75}};
    border: 2px solid {{border_strong}};
    border-radius: 8px;
}

#EquipItemIconLabel[variant="empty"] {
    background: transparent;
    border: none;
}

/* Sidebar filter rows that call out a rarity present in that group. */
#DaevanionFilterCheck {
    font-weight: {{font_weight_semibold}};
}

/* ── MASTER §4-4 data colours ──────────────────────────────────────── */
/* Generic first: every table entry app.py can ask _set_data_color() for. */

*[dataColor="item_grade:Common"] { color: {{data.item_grade.Common}}; }
*[dataColor="item_grade:Rare"] { color: {{data.item_grade.Rare}}; }
*[dataColor="item_grade:Unique"] { color: {{data.item_grade.Unique}}; }
*[dataColor="item_grade:Epic"] { color: {{data.item_grade.Epic}}; }
*[dataColor="item_grade:Legend"] { color: {{data.item_grade.Legend}}; }

*[dataColor="gear_type:PvP"] { color: {{data.gear_type.PvP}}; }
*[dataColor="gear_type:PvE"] { color: {{data.gear_type.PvE}}; }
*[dataColor="gear_type:Neutral"] { color: {{data.gear_type.Neutral}}; }

*[dataColor="skill_type:active"] { color: {{data.skill_type.active}}; }
*[dataColor="skill_type:passive"] { color: {{data.skill_type.passive}}; }
*[dataColor="skill_type:stigma"] { color: {{data.skill_type.stigma}}; }

*[dataColor="craft_method:Transfer"] { color: {{data.craft_method.Transfer}}; }
*[dataColor="craft_method:Herstellung"] { color: {{data.craft_method.Herstellung}}; }

*[dataColor="arcana_theme:Vigor"] { color: {{data.arcana_theme.Vigor}}; }
*[dataColor="arcana_theme:Magic"] { color: {{data.arcana_theme.Magic}}; }
*[dataColor="arcana_theme:Frenzy"] { color: {{data.arcana_theme.Frenzy}}; }
*[dataColor="arcana_theme:Purity"] { color: {{data.arcana_theme.Purity}}; }
*[dataColor="arcana_theme:Punishment"] { color: {{data.arcana_theme.Punishment}}; }
*[dataColor="arcana_theme:Protection"] { color: {{data.arcana_theme.Protection}}; }
*[dataColor="arcana_theme:Indomitability"] { color: {{data.arcana_theme.Indomitability}}; }

*[dataColor="arcana_category:pve"] { color: {{data.arcana_category.pve}}; }
*[dataColor="arcana_category:pvp"] { color: {{data.arcana_category.pvp}}; }
*[dataColor="arcana_category:offense"] { color: {{data.arcana_category.offense}}; }
*[dataColor="arcana_category:defence"] { color: {{data.arcana_category.defence}}; }
*[dataColor="arcana_category:cure"] { color: {{data.arcana_category.cure}}; }

*[dataColor="genius_board:Cogni"] { color: {{data.genius_board.Cogni}}; }
*[dataColor="genius_board:Fera"] { color: {{data.genius_board.Fera}}; }
*[dataColor="genius_board:Natura"] { color: {{data.genius_board.Natura}}; }
*[dataColor="genius_board:Varian"] { color: {{data.genius_board.Varian}}; }
*[dataColor="genius_board:Special"] { color: {{data.genius_board.Special}}; }

*[dataColor="damage_type:physic"] { color: {{data.damage_type.physic}}; }
*[dataColor="damage_type:magic"] { color: {{data.damage_type.magic}}; }

*[dataColor="role:Angreifer"] { color: {{data.role.Angreifer}}; }
*[dataColor="role:Verteidiger"] { color: {{data.role.Verteidiger}}; }
*[dataColor="role:Support"] { color: {{data.role.Support}}; }

/* Then the fills: a data colour that is a badge, not text. */

#TooltipGradePill[dataColor="item_grade:Common"] { background: {{data.item_grade.Common|0.2}}; color: {{data.item_grade.Common}}; }
#TooltipGradePill[dataColor="item_grade:Rare"] { background: {{data.item_grade.Rare|0.2}}; color: {{data.item_grade.Rare}}; }
#TooltipGradePill[dataColor="item_grade:Unique"] { background: {{data.item_grade.Unique|0.2}}; color: {{data.item_grade.Unique}}; }
#TooltipGradePill[dataColor="item_grade:Epic"] { background: {{data.item_grade.Epic|0.2}}; color: {{data.item_grade.Epic}}; }
#TooltipGradePill[dataColor="item_grade:Legend"] { background: {{data.item_grade.Legend|0.2}}; color: {{data.item_grade.Legend}}; }

#TooltipTypePill[dataColor="skill_type:active"] { background: {{data.skill_type.active|0.2}}; color: {{data.skill_type.active}}; }
#SkillTypeBadge[dataColor="skill_type:active"] { background-color: {{data.skill_type.active|0.16}}; color: {{data.skill_type.active}}; border: 1px solid {{data.skill_type.active|0.5}}; }
#TooltipTypePill[dataColor="skill_type:passive"] { background: {{data.skill_type.passive|0.2}}; color: {{data.skill_type.passive}}; }
#SkillTypeBadge[dataColor="skill_type:passive"] { background-color: {{data.skill_type.passive|0.16}}; color: {{data.skill_type.passive}}; border: 1px solid {{data.skill_type.passive|0.5}}; }
#TooltipTypePill[dataColor="skill_type:stigma"] { background: {{data.skill_type.stigma|0.2}}; color: {{data.skill_type.stigma}}; }
#SkillTypeBadge[dataColor="skill_type:stigma"] { background-color: {{data.skill_type.stigma|0.16}}; color: {{data.skill_type.stigma}}; border: 1px solid {{data.skill_type.stigma|0.5}}; }
#TooltipTypePill[dataColor="damage_type:physic"] { background: {{data.damage_type.physic|0.2}}; color: {{data.damage_type.physic}}; }
#SkillTypeBadge[dataColor="damage_type:physic"] { background-color: {{data.damage_type.physic|0.16}}; color: {{data.damage_type.physic}}; border: 1px solid {{data.damage_type.physic|0.5}}; }
#TooltipTypePill[dataColor="damage_type:magic"] { background: {{data.damage_type.magic|0.2}}; color: {{data.damage_type.magic}}; }
#SkillTypeBadge[dataColor="damage_type:magic"] { background-color: {{data.damage_type.magic|0.16}}; color: {{data.damage_type.magic}}; border: 1px solid {{data.damage_type.magic|0.5}}; }

#ArcanaSetInfoDot[dataColor="arcana_theme:Vigor"] { border-color: {{data.arcana_theme.Vigor}}; color: {{data.arcana_theme.Vigor}}; }
#ArcanaThemeOption[selected="true"][dataColor="arcana_theme:Vigor"] { background: {{data.arcana_theme.Vigor|0.1}}; border-color: {{data.arcana_theme.Vigor|0.35}}; }
#ArcanaThemeRadio[dataColor="arcana_theme:Vigor"]::indicator:checked { border-color: {{data.arcana_theme.Vigor}}; background: {{data.arcana_theme.Vigor}}; }
#ArcanaThemeOptionLord[selected="true"][dataColor="arcana_theme:Vigor"] { color: {{data.arcana_theme.Vigor}}; }
#ArcanaSetInfoDot[dataColor="arcana_theme:Magic"] { border-color: {{data.arcana_theme.Magic}}; color: {{data.arcana_theme.Magic}}; }
#ArcanaThemeOption[selected="true"][dataColor="arcana_theme:Magic"] { background: {{data.arcana_theme.Magic|0.1}}; border-color: {{data.arcana_theme.Magic|0.35}}; }
#ArcanaThemeRadio[dataColor="arcana_theme:Magic"]::indicator:checked { border-color: {{data.arcana_theme.Magic}}; background: {{data.arcana_theme.Magic}}; }
#ArcanaThemeOptionLord[selected="true"][dataColor="arcana_theme:Magic"] { color: {{data.arcana_theme.Magic}}; }
#ArcanaSetInfoDot[dataColor="arcana_theme:Frenzy"] { border-color: {{data.arcana_theme.Frenzy}}; color: {{data.arcana_theme.Frenzy}}; }
#ArcanaThemeOption[selected="true"][dataColor="arcana_theme:Frenzy"] { background: {{data.arcana_theme.Frenzy|0.1}}; border-color: {{data.arcana_theme.Frenzy|0.35}}; }
#ArcanaThemeRadio[dataColor="arcana_theme:Frenzy"]::indicator:checked { border-color: {{data.arcana_theme.Frenzy}}; background: {{data.arcana_theme.Frenzy}}; }
#ArcanaThemeOptionLord[selected="true"][dataColor="arcana_theme:Frenzy"] { color: {{data.arcana_theme.Frenzy}}; }
#ArcanaSetInfoDot[dataColor="arcana_theme:Purity"] { border-color: {{data.arcana_theme.Purity}}; color: {{data.arcana_theme.Purity}}; }
#ArcanaThemeOption[selected="true"][dataColor="arcana_theme:Purity"] { background: {{data.arcana_theme.Purity|0.1}}; border-color: {{data.arcana_theme.Purity|0.35}}; }
#ArcanaThemeRadio[dataColor="arcana_theme:Purity"]::indicator:checked { border-color: {{data.arcana_theme.Purity}}; background: {{data.arcana_theme.Purity}}; }
#ArcanaThemeOptionLord[selected="true"][dataColor="arcana_theme:Purity"] { color: {{data.arcana_theme.Purity}}; }
#ArcanaSetInfoDot[dataColor="arcana_theme:Punishment"] { border-color: {{data.arcana_theme.Punishment}}; color: {{data.arcana_theme.Punishment}}; }
#ArcanaThemeOption[selected="true"][dataColor="arcana_theme:Punishment"] { background: {{data.arcana_theme.Punishment|0.1}}; border-color: {{data.arcana_theme.Punishment|0.35}}; }
#ArcanaThemeRadio[dataColor="arcana_theme:Punishment"]::indicator:checked { border-color: {{data.arcana_theme.Punishment}}; background: {{data.arcana_theme.Punishment}}; }
#ArcanaThemeOptionLord[selected="true"][dataColor="arcana_theme:Punishment"] { color: {{data.arcana_theme.Punishment}}; }
#ArcanaSetInfoDot[dataColor="arcana_theme:Protection"] { border-color: {{data.arcana_theme.Protection}}; color: {{data.arcana_theme.Protection}}; }
#ArcanaThemeOption[selected="true"][dataColor="arcana_theme:Protection"] { background: {{data.arcana_theme.Protection|0.1}}; border-color: {{data.arcana_theme.Protection|0.35}}; }
#ArcanaThemeRadio[dataColor="arcana_theme:Protection"]::indicator:checked { border-color: {{data.arcana_theme.Protection}}; background: {{data.arcana_theme.Protection}}; }
#ArcanaThemeOptionLord[selected="true"][dataColor="arcana_theme:Protection"] { color: {{data.arcana_theme.Protection}}; }
#ArcanaSetInfoDot[dataColor="arcana_theme:Indomitability"] { border-color: {{data.arcana_theme.Indomitability}}; color: {{data.arcana_theme.Indomitability}}; }
#ArcanaThemeOption[selected="true"][dataColor="arcana_theme:Indomitability"] { background: {{data.arcana_theme.Indomitability|0.1}}; border-color: {{data.arcana_theme.Indomitability|0.35}}; }
#ArcanaThemeRadio[dataColor="arcana_theme:Indomitability"]::indicator:checked { border-color: {{data.arcana_theme.Indomitability}}; background: {{data.arcana_theme.Indomitability}}; }
#ArcanaThemeOptionLord[selected="true"][dataColor="arcana_theme:Indomitability"] { color: {{data.arcana_theme.Indomitability}}; }

#EquipItemIconLabel[dataColor="item_grade:Common"] { border-color: {{data.item_grade.Common}}; }
#EquipItemIconLabel[dataColor="item_grade:Rare"] { border-color: {{data.item_grade.Rare}}; }
#EquipItemIconLabel[dataColor="item_grade:Unique"] { border-color: {{data.item_grade.Unique}}; }
#EquipItemIconLabel[dataColor="item_grade:Epic"] { border-color: {{data.item_grade.Epic}}; }
#EquipItemIconLabel[dataColor="item_grade:Legend"] { border-color: {{data.item_grade.Legend}}; }

/* Last: the id-qualified copies.  These tie with `#id:hover` /
   `#id:checked` at specificity 110 and win on ORDER, which is what
   keeps a checked rarity pill its own rarity colour — the behaviour
   the inline sheet used to get for free by being inline. */

#SkillFilterButton[dataColor="item_grade:Common"] { color: {{data.item_grade.Common}}; }
#SkillFilterButton[dataColor="item_grade:Rare"] { color: {{data.item_grade.Rare}}; }
#SkillFilterButton[dataColor="item_grade:Unique"] { color: {{data.item_grade.Unique}}; }
#SkillFilterButton[dataColor="item_grade:Epic"] { color: {{data.item_grade.Epic}}; }
#SkillFilterButton[dataColor="item_grade:Legend"] { color: {{data.item_grade.Legend}}; }
#SkillFilterButton[dataColor="craft_method:Transfer"] { color: {{data.craft_method.Transfer}}; }
#SkillFilterButton[dataColor="craft_method:Herstellung"] { color: {{data.craft_method.Herstellung}}; }

#ArcanaGradePill[dataColor="item_grade:Common"] { color: {{data.item_grade.Common}}; }
#ArcanaGradePill[dataColor="item_grade:Rare"] { color: {{data.item_grade.Rare}}; }
#ArcanaGradePill[dataColor="item_grade:Unique"] { color: {{data.item_grade.Unique}}; }
#ArcanaGradePill[dataColor="item_grade:Epic"] { color: {{data.item_grade.Epic}}; }
#ArcanaGradePill[dataColor="item_grade:Legend"] { color: {{data.item_grade.Legend}}; }

#DetailInfo[dataColor="item_grade:Common"] { color: {{data.item_grade.Common}}; }
#DetailInfo[dataColor="item_grade:Rare"] { color: {{data.item_grade.Rare}}; }
#DetailInfo[dataColor="item_grade:Unique"] { color: {{data.item_grade.Unique}}; }
#DetailInfo[dataColor="item_grade:Epic"] { color: {{data.item_grade.Epic}}; }
#DetailInfo[dataColor="item_grade:Legend"] { color: {{data.item_grade.Legend}}; }

#CraftMenuRow[dataColor="item_grade:Common"] { color: {{data.item_grade.Common}}; }
#CraftMenuRow[dataColor="item_grade:Rare"] { color: {{data.item_grade.Rare}}; }
#CraftMenuRow[dataColor="item_grade:Unique"] { color: {{data.item_grade.Unique}}; }
#CraftMenuRow[dataColor="item_grade:Epic"] { color: {{data.item_grade.Epic}}; }
#CraftMenuRow[dataColor="item_grade:Legend"] { color: {{data.item_grade.Legend}}; }

#GradeTileName[dataColor="item_grade:Common"] { color: {{data.item_grade.Common}}; }
