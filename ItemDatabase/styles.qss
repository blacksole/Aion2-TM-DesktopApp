/* Standalone dark theme for the ItemDatabase test viewer.
   Color palette matches cont_ToDo_app's "Abyss" theme, copied intentionally —
   this file has no dependency on cont_ToDo_app. */

QWidget {
    color: #e5e7eb;
    font-size: 14px;
}

/* Tooltips otherwise render as a plain native OS tooltip (white/black,
   one long unwrapped line) -- User-reported, 2026-08-29, re: the
   Estimated Damage button's tooltip. Matches the app's own dark panel
   look instead. */
QToolTip {
    background-color: #0f172a;
    color: #e5e7eb;
    border: 1px solid rgba(100, 116, 139, 0.45);
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid rgba(148, 163, 184, 0.6);
    border-radius: 3px;
    background-color: rgba(15, 23, 42, 0.75);
}

QCheckBox::indicator:checked {
    background-color: rgba(34, 211, 238, 0.85);
    border: 1px solid rgba(34, 211, 238, 1.0);
}

#PageTitle {
    color: white;
    font-size: 26px;
    font-weight: bold;
}

#PageSubtitle {
    color: #94a3b8;
    font-size: 13px;
}

#TopBar {
    background-color: rgba(30, 41, 59, 0.55);
    border: 1px solid rgba(100, 116, 139, 0.45);
    border-radius: 10px;
}

QLineEdit {
    background-color: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(100, 116, 139, 0.6);
    border-radius: 9px;
    padding: 8px 12px;
    color: white;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid rgba(34, 211, 238, 0.8);
}

QComboBox {
    background-color: rgba(15, 23, 42, 0.92);
    color: #e2e8f0;
    border: 1px solid rgba(100, 116, 139, 0.45);
    border-radius: 8px;
    padding: 8px 30px 8px 12px;
    font-size: 13px;
    font-weight: 600;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid rgba(34, 211, 238, 0.7);
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

/* No down-arrow rule existed before -- drop-down reserved 22px of empty
   space but never drew anything into it, so every combo box (Grade/
   Category/Class filter row) rendered as a plain borderless field with no
   visual "this opens a dropdown" affordance. A CSS-only border-triangle
   was tried first but rendered as a solid grey square instead of a
   triangle (Qt's ::down-arrow subcontrol sizing doesn't cooperate with the
   web border-trick) -- using a real small PNG asset instead, same pattern
   as every other bundled image in this app. __DROPDOWN_ARROW_URL__ is
   substituted with an absolute file path by _load_qss_text() at runtime
   (must be absolute, not relative, so it also resolves correctly from
   inside the PyInstaller-bundled exe). */
QComboBox::down-arrow {
    image: url(__DROPDOWN_ARROW_URL__);
    width: 10px;
    height: 10px;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #0f172a;
    border: 1px solid rgba(100, 116, 139, 0.45);
    selection-background-color: rgba(34, 211, 238, 0.25);
    selection-color: white;
    /* No blanket "color" here (removed 2026-08-29, User-reported: Grade/
       Rarity dropdown items showed plain white instead of their per-
       rarity color) -- a QSS color on an item view overrides each
       QStandardItem's own setForeground() unconditionally, the same
       cascade quirk already documented elsewhere this session (Round 20,
       see project_arcana_planner.md). Falls back to the app-wide dark
       QPalette's Text role (#e5e7eb, main.py's _dark_palette) for any
       combo that doesn't color its own items -- visually identical to
       the #e2e8f0 this used to hardcode. */
    padding: 4px;
}

/* Popup list item padding only -- the hover HIGHLIGHT itself is painted in
   Python (_ComboHoverDelegate in app.py), not here: a "::item:hover" QSS
   rule was tried first (User-reported, 2026-09-02) but never took visible
   effect, the same class of "app-wide stylesheet overrides native per-item
   painting" issue _RoleColorDelegate's own docstring already documents for
   per-item text color. */
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
}


#ResultLabel {
    color: #94a3b8;
    font-size: 13px;
}

QTableView {
    background-color: rgba(15, 23, 42, 0.55);
    alternate-background-color: rgba(30, 41, 59, 0.45);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 10px;
    gridline-color: rgba(100, 116, 139, 0.25);
    color: #e5e7eb;
    selection-background-color: rgba(34, 211, 238, 0.25);
    selection-color: white;
}

QTableView::item {
    padding: 6px 10px;
    border: none;
}

QHeaderView::section {
    background-color: rgba(30, 41, 59, 0.9);
    color: #cbd5e1;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid rgba(100, 116, 139, 0.25);
    border-bottom: 1px solid rgba(100, 116, 139, 0.45);
    font-weight: 700;
    font-size: 12px;
}

QHeaderView::section:hover {
    background-color: rgba(34, 211, 238, 0.18);
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(100, 116, 139, 0.5);
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(148, 163, 184, 0.7);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(100, 116, 139, 0.5);
    border-radius: 6px;
    min-width: 24px;
}

/* Grade badge colors used in the Grade column via Qt.ForegroundRole per-item,
   kept here only as reference values used directly in app.py:
   Common #94a3b8, Rare #38bdf8, Unique #a855f7, Epic #f59e0b, Legend #facc15 */

QPushButton {
    background-color: rgba(30, 41, 59, 0.75);
    color: #e5e7eb;
    border: 1px solid rgba(100, 116, 139, 0.5);
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    border: 1px solid rgba(34, 211, 238, 0.7);
}

QPushButton:pressed {
    background-color: rgba(34, 211, 238, 0.2);
}

/* Stat Priority editor's gear icon button (QToolButton, no default styling
   of its own unlike QPushButton above) -- matches the surrounding buttons'
   card look instead of Qt's flat native ToolButton chrome. */
#StatPriorityEditBtn {
    background-color: rgba(30, 41, 59, 0.75);
    border: 1px solid rgba(100, 116, 139, 0.5);
    border-radius: 8px;
}

#StatPriorityEditBtn:hover {
    border: 1px solid rgba(34, 211, 238, 0.7);
}

#StatPriorityEditBtn:pressed {
    background-color: rgba(34, 211, 238, 0.2);
}

/* Per-skill level -/+ buttons (Skill Description cards) -- same card look
   as the default QPushButton rule above, just without its 8px/14px padding,
   which would otherwise crush a 26x26 icon-only button down to almost
   nothing. */
#SkillLevelStepBtn {
    padding: 0px;
}

#SkillLevelValue {
    color: white;
    font-weight: 700;
    font-size: 14px;
}

/* Arcana wish -/+ counter (User-Wunsch, 2026-08-28/29) -- same icon-only
   sizing fix as #SkillLevelStepBtn, plus a subtle purple hover so it reads
   as a distinct, secondary control from the main level counter above it. */
#ArcanaWishStepBtn {
    padding: 0px;
    border-radius: 10px;
}

#ArcanaWishStepBtn:hover {
    background-color: rgba(192, 132, 252, 0.18);
}

#DetailIcon {
    background-color: rgba(71, 85, 105, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.4);
    border-radius: 12px;
}

#DetailName {
    color: white;
    font-weight: 700;
    font-size: 14px;
}

#DetailHeader {
    color: white;
    font-size: 18px;
    font-weight: 700;
}

#GearScoreHeaderLabel {
    color: #22d3ee;
    font-size: 20px;
    font-weight: 800;
}

#DetailInfo {
    color: #cbd5e1;
    font-size: 13px;
}

#DetailEnchantValue {
    color: #facc15;
    font-weight: 700;
    font-size: 14px;
}

#EquipPriorityArrow {
    color: #22d3ee;
    font-weight: 800;
    font-size: 28px;
}

#ChainNode {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    color: #94a3b8;
    font-size: 9.5px;
    padding: 4px;
}
#ChainNode:hover:enabled {
    background: rgba(148, 163, 184, 0.08);
}
#ChainNode[expanded="true"] {
    background: rgba(34, 211, 238, 0.14);
    border-color: rgba(34, 211, 238, 0.4);
}
#ChainNode:disabled {
    color: #64748b;
}

#ExpandableMaterialHeader {
    background: transparent;
    border: none;
    color: #e5e7eb;
    font-size: 13px;
    text-align: left;
    padding: 4px 0;
}
#ExpandableMaterialHeader:hover {
    color: #22d3ee;
}
#ExpandableMaterialHeader[expanded="true"] {
    color: #22d3ee;
}

#ChainArrow {
    color: #22d3ee;
    font-weight: 700;
    font-size: 15px;
    padding-top: 14px;
}

#ChainSidePanel {
    background: rgba(15, 21, 34, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 8px;
}

#ChainSideLabel {
    color: #22d3ee;
    font-size: 10.5px;
}

#DetailDisclaimer {
    color: #f59e0b;
    font-size: 11px;
    font-style: italic;
}

#SlotIconButton {
    background-color: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(100, 116, 139, 0.5);
    border-radius: 14px;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 600;
    padding: 4px;
}

#SlotIconButton:hover {
    border: 1px solid rgba(34, 211, 238, 0.8);
    background-color: rgba(34, 211, 238, 0.1);
}

#SlotIconButton:pressed {
    background-color: rgba(34, 211, 238, 0.25);
}

/* Pantheon board (User-Wunsch, 2026-09-04) -- radially-positioned slots
   drawn straight onto #PantheonCanvas (no layout manager, see
   _build_pantheon_tab), so this panel needs its own explicit dark
   background rather than inheriting one from a layout container. Artwork
   keeps #SlotIconButton's rounded-rect look; Statue/Colossus get a real
   circular radius (half their own fixed size) to match the sketch, with
   Colossus additionally gold-accented since it's the board's centerpiece. */
#PantheonCanvas {
    background-color: rgba(11, 18, 32, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 16px;
}

#PantheonArtworkSlot,
#PantheonStatueSlot,
#PantheonColossusSlot {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(100, 116, 139, 0.5);
    color: #94a3b8;
}

#PantheonArtworkSlot {
    border-radius: 12px;
}

#PantheonStatueSlot {
    border-radius: 33px;
}

#PantheonColossusSlot {
    border-radius: 54px;
    border: 2px solid rgba(250, 204, 21, 0.55);
}

#PantheonArtworkSlot:hover,
#PantheonStatueSlot:hover {
    border-color: rgba(34, 211, 238, 0.8);
    background-color: rgba(34, 211, 238, 0.1);
}

#PantheonColossusSlot:hover {
    border-color: rgba(250, 204, 21, 0.9);
    background-color: rgba(250, 204, 21, 0.12);
}

#PantheonArtworkSlot:pressed,
#PantheonStatueSlot:pressed {
    background-color: rgba(34, 211, 238, 0.25);
}

#PantheonColossusSlot:pressed {
    background-color: rgba(250, 204, 21, 0.25);
}

/* "Active" slot -- the one the left inventory panel is currently assigning
   into (User-Wunsch, 2026-09-05, replacing the per-slot popup picker).
   Set via a dynamic property (see _on_pantheon_slot_clicked), not :checked,
   since QToolButton here isn't checkable -- only ever one slot at a time. */
#PantheonArtworkSlot[pantheonActive="true"],
#PantheonStatueSlot[pantheonActive="true"] {
    border: 2px solid rgba(34, 211, 238, 1.0);
    background-color: rgba(34, 211, 238, 0.22);
}

#PantheonColossusSlot[pantheonActive="true"] {
    border: 2px solid rgba(250, 204, 21, 1.0);
    background-color: rgba(250, 204, 21, 0.22);
}

#SlotEnchantLabel {
    background: transparent;
    border: none;
    color: #c084fc;
    font-size: 11px;
    font-weight: 700;
    padding: 1px;
}

#EquipSectionLabel {
    color: #22d3ee;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

#SkillFilterButton {
    background-color: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.4);
    border-radius: 8px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
}

#SkillFilterButton:hover {
    border: 1px solid rgba(34, 211, 238, 0.6);
    color: #e5e7eb;
}

#SkillFilterButton:checked {
    background-color: rgba(34, 211, 238, 0.22);
    border: 1px solid rgba(34, 211, 238, 0.9);
    color: #22d3ee;
}

/* "Estimated Damage" toggle -- same base look as SkillFilterButton, but
   with the damage-number orange accent (User-Wunsch, 2026-08-29: "leicht
   von den anderen Filtern abheben ... leicht orange faerben") so it reads
   as a different KIND of toggle (an estimate, not a filter) rather than
   blending into the Favorites/Checked-only pills next to it. Own
   #-scoped rule, not #SkillFilterButton directly, so this doesn't affect
   any other SkillFilterButton in the app. */
#SkillEstimatedDamageButton {
    background-color: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 8px;
    color: #d8a253;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
}

#SkillEstimatedDamageButton:hover {
    border: 1px solid rgba(245, 158, 11, 0.7);
    color: #f59e0b;
}

#SkillEstimatedDamageButton:checked {
    background-color: rgba(245, 158, 11, 0.2);
    border: 1px solid rgba(245, 158, 11, 0.9);
    color: #f59e0b;
}

/* "EQ Priority" button, bottom-right of the Jewelry column -- same base
   look as SkillFilterButton but bigger font/padding since the plain
   12px/4-10px version still read as too small/easy to miss there
   (User-Wunsch, 2026-08-27: "der Button unten Rechts wird sonst
   übersehen ... einen längeren Button ... Schriftgröße anpassen"). Own
   #-scoped rule, not #SkillFilterButton directly, so this doesn't affect
   any other SkillFilterButton in the app. */
#EqPriorityButton {
    background-color: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.4);
    border-radius: 9px;
    color: #94a3b8;
    font-size: 15px;
    font-weight: 700;
    padding: 8px 20px;
}

#EqPriorityButton:hover {
    border: 1px solid rgba(34, 211, 238, 0.6);
    color: #e5e7eb;
}

/* Back-arrow/X pair on a full-panel takeover page (EQ Priority, and reused
   by any future one) -- plain QToolButtons had no styling at all before
   this, just bare native icon chrome (User-Wunsch, 2026-08-28: "den
   Backpfeil und das 'X' an den Stil anpassen"). Same dark-card/cyan-hover
   language as #SlotIconButton, just round for a 32px icon button instead
   of square for a slot tile. */
#PanelNavButton {
    background-color: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(100, 116, 139, 0.5);
    border-radius: 16px;
}

#PanelNavButton:hover {
    border: 1px solid rgba(34, 211, 238, 0.8);
    background-color: rgba(34, 211, 238, 0.1);
}

#PanelNavButton:pressed {
    background-color: rgba(34, 211, 238, 0.25);
}

/* Small "x" overlay badge on a filled Skill Priority List slot (User-Wunsch,
   2026-08-28: "die Möglichkeit ... Skills zu entfernen"). */
#PrioritySlotRemoveBtn {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(100, 116, 139, 0.6);
    border-radius: 9px;
}

#PrioritySlotRemoveBtn:hover {
    border: 1px solid rgba(248, 113, 113, 0.8);
    background-color: rgba(248, 113, 113, 0.2);
}

/* Eigenschaften-Priorität Rolle buttons -- same base look as
   SkillFilterButton, but each role gets its own accent color when checked
   (User-Wunsch: "Angreifer 'Orange', Verteidiger 'Blau' und Support
   'Grün'... bei Auswahl des Reiters eine entsprechende Farbkombi"). Own
   #-scoped rules instead of reusing #SkillFilterButton so this doesn't
   affect any other SkillFilterButton in the app. */
#RoleButtonAngreifer, #RoleButtonVerteidiger, #RoleButtonSupport {
    background-color: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.4);
    border-radius: 8px;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
}

#RoleButtonAngreifer:hover { border: 1px solid rgba(251, 146, 60, 0.6); color: #e5e7eb; }
#RoleButtonVerteidiger:hover { border: 1px solid rgba(96, 165, 250, 0.6); color: #e5e7eb; }
#RoleButtonSupport:hover { border: 1px solid rgba(74, 222, 128, 0.6); color: #e5e7eb; }

#RoleButtonAngreifer:checked {
    background-color: rgba(251, 146, 60, 0.22);
    border: 1px solid rgba(251, 146, 60, 0.9);
    color: #fb923c;
}
#RoleButtonVerteidiger:checked {
    background-color: rgba(96, 165, 250, 0.22);
    border: 1px solid rgba(96, 165, 250, 0.9);
    color: #60a5fa;
}
#RoleButtonSupport:checked {
    background-color: rgba(74, 222, 128, 0.22);
    border: 1px solid rgba(74, 222, 128, 0.9);
    color: #4ade80;
}

#SkillTileIcon {
    background-color: rgba(15, 23, 42, 0.75);
    border: 2px solid rgba(34, 211, 238, 0.6);
    border-radius: 10px;
}

#SkillTileIcon:hover {
    border: 2px solid rgba(34, 211, 238, 0.9);
}

#SkillTileIcon:checked {
    background-color: rgba(250, 204, 21, 0.18);
    border: 2px solid rgba(250, 204, 21, 0.9);
}

#SkillTileName {
    color: #38bdf8;
    font-size: 11px;
    font-weight: 600;
}

#SkillRowIcon {
    background-color: rgba(15, 23, 42, 0.75);
    border: 2px solid rgba(34, 211, 238, 0.5);
    border-radius: 8px;
}

#ItemPickerPopup {
    /* No longer a real Qt.Popup (2026-08-29, see ItemPickerPopup's
       docstring) -- lost the native window's own edge against the page
       behind it, which happened to be the exact same #0f172a. Lighter
       slate background (matches #SubstatRow's rgba(30,41,59,...) tone)
       + a solid, thicker border give it a visible boundary again
       (User-reported: "brauchen wir jetzt farblich einen Unterschied"). */
    background-color: #1e293b;
    border: 2px solid rgba(34, 211, 238, 0.9);
    border-radius: 10px;
}

#ArcanaCardButton {
    background-color: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(100, 116, 139, 0.5);
    border-radius: 14px;
}

#ArcanaCardButton:hover {
    border: 1px solid rgba(34, 211, 238, 0.7);
}

#ArcanaCardButton[state="themed"] {
    background-color: rgba(41, 32, 10, 0.4);
    border: 2px solid rgba(250, 204, 21, 0.55);
}

#ArcanaCardButton[state="themed"]:hover {
    border: 2px solid #facc15;
}

#ArcanaCardButton[state="unavailable"] {
    background-color: rgba(15, 23, 42, 0.4);
    border: 2px dashed rgba(100, 116, 139, 0.4);
}

#ArcanaCardName {
    color: white;
    font-weight: 700;
    font-size: 13px;
}

#ArcanaCardInfo {
    font-size: 11px;
}

#ArcanaCardHint {
    color: #94a3b8;
    font-size: 13px;
    font-weight: 700;
}

/* One of the 4 fixed skill-slot boxes on a Sets-tab card (User-Wunsch,
   2026-08-29, rough mockup screenshot) -- plain bordered box, blank when
   that slot isn't filled yet. */
#ArcanaEquipSkillSlot {
    background-color: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 6px;
    font-size: 11px;
}

/* Now clickable (manual per-slot skill/level editing, 2026-08-29) --
   hover affordance so it reads as interactive, matching #SubstatRow etc. */
#ArcanaEquipSkillSlot:hover {
    border: 1px solid rgba(34, 211, 238, 0.6);
    background-color: rgba(34, 211, 238, 0.06);
}

/* Gated behind picking a Set first (User-Wunsch, 2026-08-29: "Wenn keine
   Karte hinterlegt ist, sollte keine Eigenschaft waehlbar sein") --
   visibly inert instead of just silently not responding to clicks. */
#ArcanaEquipSkillSlot:disabled {
    background-color: rgba(15, 23, 42, 0.3);
    border: 1px dashed rgba(100, 116, 139, 0.25);
}

/* Card-level rarity pills (manual grade selection, 2026-08-29) -- each
   pill's own text color comes from GRADE_COLORS via an inline
   setStyleSheet (per-grade, set in _ArcanaCardButton), this only
   provides the shared pill chrome/checked state. */
#ArcanaGradePill {
    background-color: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 5px;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
}

#ArcanaGradePill:checked {
    background-color: rgba(148, 163, 184, 0.18);
    border: 1px solid rgba(148, 163, 184, 0.6);
}

#ArcanaGradePill:disabled {
    color: #475569;
    border: 1px dashed rgba(100, 116, 139, 0.25);
}

#ArcanaNoneButton {
    background-color: rgba(30, 41, 59, 0.6);
    border: 2px solid rgba(100, 116, 139, 0.5);
    border-radius: 10px;
    color: #94a3b8;
    font-weight: 700;
    font-size: 13px;
}

#ArcanaNoneButton:checked {
    border: 2px solid #22d3ee;
    color: #22d3ee;
    background-color: rgba(34, 211, 238, 0.1);
}

/* #ArcanaSetBanner is now a fully custom-painted widget (_ArcanaSetBanner
   in app.py, Round 21) -- background photo/gradient, overlay, border and
   text are all drawn directly in paintEvent, so no QSS rule for it
   actually applies (paintEvent never calls the default button painting). */

#ArcanaLordBar {
    background-color: rgba(30, 41, 59, 0.55);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 12px;
}

#EquipItemComboButton {
    background-color: rgba(15, 23, 42, 0.75);
    color: #e5e7eb;
    border: 1px solid rgba(100, 116, 139, 0.6);
    border-radius: 9px;
    padding: 8px 12px;
    font-weight: 600;
    text-align: left;
}

#EquipItemComboButton:hover {
    border: 1px solid rgba(34, 211, 238, 0.7);
}

#SubstatRow {
    background-color: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 6px;
    text-align: left;
}

#SubstatRow:hover {
    border: 1px solid rgba(34, 211, 238, 0.6);
    background-color: rgba(34, 211, 238, 0.06);
}

#SubstatRow:checked {
    background-color: rgba(250, 204, 21, 0.1);
    border: 1px solid rgba(250, 204, 21, 0.6);
}

#SubstatRow:disabled {
    color: #475569;
}

#SkillDescCard {
    background-color: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 10px;
    text-align: left;
}

#SkillDescCard:hover {
    border: 1px solid rgba(250, 204, 21, 0.5);
}

#SkillRow {
    background: transparent;
    border: none;
    border-radius: 8px;
}

#SkillRow:hover {
    background-color: rgba(34, 211, 238, 0.06);
}

#SkillSectionHeader {
    color: white;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    text-align: left;
    padding: 4px 2px;
    border: none;
    background: transparent;
}

#SkillSectionHeader:hover {
    color: #22d3ee;
}

#ClassSelectButton {
    background-color: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(100, 116, 139, 0.45);
    border-radius: 12px;
}

#ClassSelectButton:hover {
    border: 1px solid rgba(34, 211, 238, 0.8);
    background-color: rgba(34, 211, 238, 0.08);
}

#ClassSelectButton:pressed {
    background-color: rgba(34, 211, 238, 0.2);
}

#LoadoutBackground {
    background-color: #0f172a;
}

/* Substats/Skills tab pages (ItemDetailWidget) -- explicit background
   instead of relying on QPalette fallback, matching #LoadoutBackground's
   pattern; without this the page widget's own unstyled background paints
   over QTabWidget::pane's dark color, showing as a plain white/grey box
   when Windows itself is set to dark mode (User-reported, 2026-08-29). */
#StatsPane {
    background-color: #0f172a;
}

#StatRowCell {
    border: none;
    border-bottom: 1px solid rgba(100, 116, 139, 0.25);
}

QTabWidget::pane {
    background-color: #0f172a;
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-top: none;
    top: -1px;
}

QTabBar::tab {
    background: rgba(15, 23, 42, 0.5);
    color: #94a3b8;
    padding: 8px 16px;
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0f172a;
    color: #22d3ee;
    border: 1px solid rgba(34, 211, 238, 0.6);
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    color: #e5e7eb;
}

QListWidget {
    background-color: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(100, 116, 139, 0.45);
    border-radius: 8px;
    color: #e5e7eb;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background-color: rgba(34, 211, 238, 0.25);
    color: white;
}

/* Daevanion Board tab (2026-08-28) -- functional-first styling, visuals to
   be revisited once the board itself is confirmed working (User-Wunsch:
   "dann schauen wir, wie wir die Optik anpassen müssen"). */
#DaevanionCanvasFrame {
    background-color: #0b1220;
    border: 1px solid rgba(100, 116, 139, 0.4);
    border-radius: 12px;
}

/* Sidebar accordion -- real card background per section (not just an
   outline against the bare window background) + collapsible header
   (User-Wunsch, 2026-08-28: "hier bitte nochmal den Hintergrund anpassen
   und Accordions bauen"). */
#DaevanionAccordionSection {
    background-color: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 10px;
}

#DaevanionAccordionHeader {
    background: transparent;
    border: none;
    border-radius: 10px;
    color: #22d3ee;
    font-weight: 700;
    font-size: 13px;
    text-align: left;
    padding: 10px 12px;
}

#DaevanionAccordionHeader:hover {
    background-color: rgba(34, 211, 238, 0.08);
}

#DaevanionAccordionBody {
    background: transparent;
}

/* ── "Genius Insight" tab ─────────────────────────────────────────────── */

#GeniusSectionTitle {
    color: white;
    font-size: 14px;
    font-weight: 700;
}

#GeniusHint {
    color: #8b96ac;
    font-size: 11px;
}

#GeniusOwnedTotalNote {
    color: #22d3ee;
    font-size: 11px;
}

#GeniusSegBtn {
    background-color: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 6px;
    color: #8b96ac;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 0;
}

#GeniusSegBtn:hover {
    color: #e7ebf3;
}

#GeniusSegBtn:checked {
    background-color: rgba(148, 163, 184, 0.16);
    border: 1px solid rgba(148, 163, 184, 0.55);
    color: #e7ebf3;
}

#GeniusOwnedGroupTitle {
    color: #57637c;
    font-size: 10px;
    font-weight: 700;
    padding-top: 4px;
}

#GeniusOwnedTile {
    background-color: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.25);
    border-radius: 6px;
}

#GeniusOwnedName {
    color: #f2a33e;
    font-size: 11px;
    font-weight: 600;
}

#GeniusOwnedValue {
    color: #e7ebf3;
    font-size: 13px;
    font-weight: 700;
}

#GeniusPetTitle {
    font-size: 14px;
    font-weight: 700;
}

#GeniusBoardTabBtn {
    background-color: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 6px;
    color: #8b96ac;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
}

#GeniusBoardTabBtn:hover {
    color: #e7ebf3;
}

#GeniusBoardTabBtn:checked {
    background-color: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.55);
    color: #22d3ee;
}

#GeniusBoardTitle {
    color: white;
    font-size: 16px;
    font-weight: 700;
}

#GeniusLvlBadge {
    color: #22d3ee;
    font-size: 12px;
    font-weight: 600;
}

#GeniusLineIndex {
    color: #57637c;
    font-size: 10px;
    font-weight: 600;
}

#GeniusLockToggle {
    background: transparent;
    border: none;
    font-size: 12px;
    padding: 0;
}

#GeniusLineName {
    color: #f2a33e;
    font-size: 12px;
    font-weight: 600;
}

#GeniusLineCombo {
    background-color: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 6px;
}

#GeniusLineComboText {
    color: #f2a33e;
    font-size: 12px;
    font-weight: 600;
}

#GeniusLineComboRange {
    color: #f2a33e;
    font-size: 11px;
}

#GeniusLineCombo:hover {
    border: 1px solid rgba(148, 163, 184, 0.55);
}

#GeniusLineCombo:disabled {
    border: 1px dashed rgba(100, 116, 139, 0.25);
}

#GeniusLineComboText:disabled {
    color: #57637c;
}

#GeniusLineComboRange:disabled {
    color: #3d465a;
}

#GeniusStatPopup {
    background-color: #17233a;
    border: 1px solid rgba(148, 163, 184, 0.5);
    border-radius: 8px;
}

#GeniusStatPopupSearch {
    background-color: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 6px;
    color: #e7ebf3;
    font-size: 12px;
    padding: 5px 8px;
}

#GeniusStatPopupList {
    background-color: transparent;
    border: none;
    color: #e7ebf3;
    font-size: 12px;
    outline: none;
}

#GeniusStatPopupList::item {
    padding: 0;
    border-radius: 5px;
}

#GeniusStatPopupList::item:hover {
    background-color: rgba(34, 211, 238, 0.1);
}

#GeniusStatPopupList::item:selected {
    background-color: rgba(34, 211, 238, 0.18);
}

#GeniusStatPopupItemName {
    color: #f2a33e;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

#GeniusStatPopupItemRange {
    color: #8b96ac;
    font-size: 11px;
    background: transparent;
}

#GeniusLineValue {
    background-color: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(100, 116, 139, 0.35);
    border-radius: 6px;
    color: #e7ebf3;
    font-size: 12px;
    font-weight: 600;
    padding: 3px 6px;
}

#GeniusLineValue:disabled {
    color: #57637c;
    border: 1px dashed rgba(100, 116, 139, 0.25);
}
